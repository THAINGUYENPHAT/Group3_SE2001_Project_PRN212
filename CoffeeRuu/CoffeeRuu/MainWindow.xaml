<Window x:Class="CoffeeRuu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CoffeeRuu.Views"
        Title="CoffeeRuu - Trang chủ"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Thanh menu bên trái -->
        <Border Grid.Column="0"
                Background="#3B2F2F">
            <StackPanel Margin="20">
                <TextBlock Text="CoffeeRuu"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,10,0,35"/>

                <Button Content="🏠  Trang chủ"
                        Height="42"
                        Margin="0,0,0,10"/>

                <!-- Đã thêm nút Sơ đồ bàn -->
                <Button Content="🍽️  Sơ đồ bàn"
                        Height="42"
                        Margin="0,0,0,10"/>

                <Button Content="☕  Sản phẩm"
                        Height="42"
                        Margin="0,0,0,10"/>

                <Button Content="🧾  Đơn hàng"
                        Height="42"
                        Margin="0,0,0,10"/>

                <Button Content="📦  Kho hàng"
                        Height="42"
                        Margin="0,0,0,10"/>

                <Button Content="👥  Nhân viên"
                        Height="42"
                        Margin="0,0,0,10"/>

                <Button Content="📊  Báo cáo"
                        Height="42"
                        Margin="0,0,0,10"/>
            </StackPanel>
        </Border>

        <!-- Nội dung trang chủ: Đã thay thế bằng ContentControl để gọi View của bạn -->
        <ContentControl Grid.Column="1">
            <views:TableFloorView />
        </ContentControl>
    </Grid>
</Window>