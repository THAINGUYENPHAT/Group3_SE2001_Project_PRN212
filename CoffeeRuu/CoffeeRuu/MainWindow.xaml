<Window x:Class="CoffeeRuu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoffeeRuu - Đăng nhập"
        Height="600"
        Width="950"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Ben trai: gioi thieu ung dung -->
        <Border Grid.Column="0"
                Background="#4E342E"
                Padding="40">

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="CoffeeRuu"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="#FFF8E7"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="MINI CAFE MANAGEMENT SYSTEM"
                           FontSize="13"
                           Foreground="#D7CCC8"
                           Margin="0,12,0,30"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Quản lý quán cà phê&#10;đơn giản và hiệu quả"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"
                           LineHeight="38"/>

                <TextBlock Text="Quản lý menu • Đơn hàng • Kho hàng"
                           FontSize="13"
                           Foreground="#D7CCC8"
                           Margin="0,25,0,0"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Ben phai: form dang nhap -->
        <Grid Grid.Column="1" Margin="45">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Chào mừng trở lại!"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="#4E342E"/>

                <TextBlock Text="Đăng nhập vào hệ thống CoffeeRuu"
                           FontSize="14"
                           Foreground="#795548"
                           Margin="0,8,0,30"/>

                <TextBlock Text="Tên đăng nhập"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="UsernameTextBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Height="42"
                         FontSize="15"
                         Padding="10,8"
                         Margin="0,0,0,20"/>

                <TextBlock Text="Mật khẩu"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <PasswordBox x:Name="PasswordInput"
                             Height="42"
                             FontSize="15"
                             Padding="10,8"
                             Margin="0,0,0,25"/>

                <Button Content="ĐĂNG NHẬP"
                        Command="{Binding LoginCommand}"
                        Height="45"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#6D4C41"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <TextBlock Text="CoffeeRuu © 2026"
                           Foreground="#8D6E63"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>