<Window x:Class="CoffeeRuu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoffeeRuu - Hệ thống quản lý"
        Height="600"
        Width="950"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F0E8">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bên trái: Thanh Navigation Menu -->
        <Border Grid.Column="0"
                Background="#4E342E"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Brand -->
                <StackPanel Grid.Row="0" Margin="0,10,0,20">
                    <TextBlock Text="CoffeeRuu"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#FFF8E7"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="MINI CAFE MANAGEMENT SYSTEM"
                               FontSize="11"
                               Foreground="#D7CCC8"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Danh sách Menu chính -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="🏠  Trang chủ"
                                Height="42"
                                Margin="0,0,0,10"
                                Click="BtnHome_Click"/>

                        <Button Content="📃 Menu" 
                                Height="42" 
                                Margin="0,0,0,10"
                                Click="BtnMenu_Click"/>

                        <Button Content="☕  Sản phẩm"
                                Height="42"
                                Margin="0,0,0,10"
                                Click="BtnProduct_Click"/>

                        <Button Content="🧾  Đơn hàng"
                                Height="42"
                                Margin="0,0,0,10"
                                Click="OpenOrders_Click"/>

                        <Button Content="📺  KDS - Pha chế"
                                Height="42"
                                Margin="0,0,0,10"
                                Click="OpenKds_Click"/>

                        <Button Content="📦  Kho hàng"
                                Height="42"
                                Margin="0,0,0,10"
                                Click="BtnInventory_Click"/>

                        <Button Content="👥  Nhân viên"
                                Height="42"
                                Margin="0,0,0,10"/>

                        <Button Content="📊  Báo cáo"
                                Height="42"
                                Margin="0,0,0,10"
                                Click="BtnReport_Click"/>

                        <Button Content="🪑  Quản lý Bàn"
                                Height="42"
                                Margin="0,0,0,10"
                                Click="BtnTable_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Nút Đăng xuất ở dưới cùng -->
                <Button Grid.Row="2"
                        x:Name="BtnLogout"
                        Content="🚪  Đăng xuất"
                        Height="42"
                        Margin="0,10,0,0"
                        Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <!-- Bên phải: Nội dung chính / Frame điều hướng -->
        <Grid Grid.Column="1">
            <!-- Content Dashboard Mặc định -->
            <ScrollViewer x:Name="HomeContent"
                          Visibility="Visible"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock Text="Tổng quan"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#3B2F2F"/>

                    <TextBlock Text="Chào mừng đến với hệ thống quản lý CoffeeRuu!"
                               FontSize="16"
                               Margin="0,8,0,25"
                               Foreground="#666666"/>

                    <UniformGrid Columns="2" Margin="0,0,0,25">
                        <Border Background="White" CornerRadius="10" Padding="20" Margin="5">
                            <StackPanel>
                                <TextBlock Text="☕ Sản phẩm" FontSize="18" Foreground="#777777"/>
                                <TextBlock Text="Quản lý sản phẩm" FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="10" Padding="20" Margin="5">
                            <StackPanel>
                                <TextBlock Text="🧾 Đơn hàng" FontSize="18" Foreground="#777777"/>
                                <TextBlock Text="Quản lý đơn hàng" FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="10" Padding="20" Margin="5">
                            <StackPanel>
                                <TextBlock Text="📦 Kho hàng" FontSize="18" Foreground="#777777"/>
                                <TextBlock Text="Quản lý nguyên liệu" FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="10" Padding="20" Margin="5">
                            <StackPanel>
                                <TextBlock Text="📊 Báo cáo" FontSize="18" Foreground="#777777"/>
                                <TextBlock Text="Theo dõi doanh thu" FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="Chức năng hệ thống" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Border Background="White" CornerRadius="10" Padding="20">
                        <TextBlock Text="Chọn một chức năng ở thanh menu bên trái để bắt đầu quản lý quán cà phê."
                                   FontSize="15"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Frame để hiển thị các Page khi bấm Menu -->
            <Frame x:Name="MainContent"
                   NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>