<Window x:Class="CoffeeRuu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoffeeRuu - Trang chủ"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Thanh menu bên trái -->
        <Border Grid.Column="0" Background="#3B2F2F">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <TextBlock Grid.Row="0"
                           Text="CoffeeRuu"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,10,0,30"/>

                <!-- Danh sách Menu chính -->
                <StackPanel Grid.Row="1">
                    <Button Content="🏠  Trang chủ"
                            Height="42"
                            Margin="0,0,0,10"
                            Command="{Binding NavigateHomeCommand}"/>

                    <Button Content="📃 Menu"
                            Height="42"
                            Margin="0,0,0,10"
                            Command="{Binding NavigateMenuCommand}"/>

                    <Button Content="☕ Sản phẩm"
                            Height="42"
                            Margin="0,0,0,10"
                            Command="{Binding NavigateProductCommand}"/>

                    <Button Content="🧾 Đơn hàng"
                            Height="42"
                            Margin="0,0,0,10"
                            Command="{Binding NavigateOrdersCommand}"/>             

                    <Button Content="📺 KDS - Pha chế"
                            Height="42"
                            Margin="0,0,0,10"
                            Command="{Binding NavigateKdsCommand}"/>

                    <Button Content="📦  Kho hàng"
                            Height="42"
                            Margin="0,0,0,10"
                            Command="{Binding InventoryCommand}"/>

                    <Button Content="📊  Báo cáo"
                            Height="42"
                            Margin="0,0,0,10"
                            Command="{Binding ReportCommand}"/>

                    <Button Content="🪑  Quản lý Bàn"
                            Height="42"
                            Margin="0,0,0,10"
                            Command="{Binding TableCommand}"/>

                    <Button Content="👥  Nhân viên"
                            Height="42"
                            Margin="0,0,0,10"/>

                </StackPanel>

                <!-- Nút Đăng xuất ở dưới cùng -->
                <Button Grid.Row="2"
                        Content="🚪  Đăng xuất"
                        Height="42"
                        Margin="0,10,0,10"
                        Command="{Binding LogoutCommand}"/>
            </Grid>
        </Border>

        <Frame x:Name="MainContent"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>