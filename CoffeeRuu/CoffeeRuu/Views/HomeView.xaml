<UserControl x:Class="CoffeeRuu.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA"
             Loaded="UserControl_Loaded">

    <!-- Dùng ScrollViewer để có thể cuộn nếu nội dung dài -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- ================= PHẦN 1: TỔNG QUAN (Giữ lại từ thiết kế cũ) ================= -->
            <TextBlock Text="Tổng quan"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#3B2F2F"/>

            <TextBlock Text="Chào mừng đến với hệ thống quản lý CoffeeRuu!"
                       FontSize="16"
                       Margin="0,8,0,25"
                       Foreground="#666666"/>

            <!-- 4 thẻ chức năng -->
            <UniformGrid Columns="2" Margin="0,0,0,30">
                <Border Background="White" CornerRadius="10" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="☕ Sản phẩm" FontSize="18" Foreground="#777777"/>
                        <TextBlock Text="Quản lý sản phẩm" FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="🧾 Đơn hàng" FontSize="18" Foreground="#777777"/>
                        <TextBlock Text="Quản lý đơn hàng" FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📦 Kho hàng" FontSize="18" Foreground="#777777"/>
                        <TextBlock Text="Quản lý nguyên liệu" FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="20" Margin="5">
                    <StackPanel>
                        <TextBlock Text="📊 Báo cáo" FontSize="18" Foreground="#777777"/>
                        <TextBlock Text="Theo dõi doanh thu" FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                        <TextBlock DataContext="" FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                                               
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ================= PHẦN 2: SƠ ĐỒ BÀN (Tự động đổi màu) ================= -->
            <TextBlock Text="Tình trạng Sơ đồ Bàn"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#3B2F2F"
                       Margin="0,0,0,15"/>

            <Border Background="White" CornerRadius="10" Padding="20">
                <!-- ItemsControl tự động lấy 5 bàn từ Database và vẽ ra giao diện -->
                <ItemsControl ItemsSource="{Binding Tables}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Xếp 5 bàn thành 1 hàng ngang -->
                            <UniformGrid Columns="5" Rows="1" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10" Padding="15" CornerRadius="12" MinHeight="140">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- DataTrigger tự động đổi màu nền dựa vào TableStatus -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TableStatus}" Value="Available">
                                                <Setter Property="Background" Value="#2ecc71"/>
                                                <!-- Xanh lá: Trống -->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TableStatus}" Value="Occupied">
                                                <Setter Property="Background" Value="#e74c3c"/>
                                                <!-- Đỏ: Có khách -->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TableStatus}" Value="Reserved">
                                                <Setter Property="Background" Value="#f39c12"/>
                                                <!-- Vàng cam: Đặt trước -->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TableStatus}" Value="OutOfService">
                                                <Setter Property="Background" Value="#95a5a6"/>
                                                <!-- Xám: Bảo trì -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <!-- Nội dung chữ bên trong từng ô Bàn -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TableName}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TableStatus}" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding Capacity, StringFormat='Số ghế: {0}'}" FontSize="13" Foreground="#E8E8E8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>