<UserControl x:Class="CoffeeRuu.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- Header -->
            <TextBlock Text="Tổng quan"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#202938"/>

            <TextBlock x:Name="GreetingText"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#475569"
                       Margin="0,12,0,5"/>

            <TextBlock Text="Chào mừng bạn quay trở lại với CoffeeRuu. Chúc bạn có một ngày làm việc hiệu quả!"
                       FontSize="14"
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       Margin="0,0,0,25"/>

            <!-- Account Information -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#E8EEFF"
                                CornerRadius="10"
                                Width="48"
                                Height="48">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="24"
                                       Foreground="#4568C7"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="14,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Thông tin tài khoản"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#202938"/>

                            <TextBlock Text="Thông tin nhân viên đang đăng nhập"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,15,20">
                            <TextBlock Text="Họ và tên"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding FullName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#202938"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,0,20">
                            <TextBlock Text="Mã nhân viên"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding EmployeeId}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#202938"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,15,0">
                            <TextBlock Text="Tên đăng nhập"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding Username}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#202938"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1">
                            <TextBlock Text="Vai trò"
                                       FontSize="13"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding RoleName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#4568C7"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About CoffeeRuu -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE71D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="23"
                                   Foreground="#A87548"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Giới thiệu CoffeeRuu"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#202938"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="CoffeeRuu là hệ thống quản lý quán cà phê, hỗ trợ quản lý sản phẩm, đơn hàng, bàn, kho nguyên liệu và tài khoản nhân viên. Hệ thống cung cấp các chức năng theo quyền hạn của từng vai trò, giúp các hoạt động trong quán được quản lý thuận tiện và nhất quán."
                               FontSize="14"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               LineHeight="23"/>
                </StackPanel>
            </Border>

            <!-- Role-specific Information -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="24">

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE8D4;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="23"
                                   Foreground="#4568C7"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Chức năng dành cho bạn"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#202938"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="RoleTitleText"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="RoleDescriptionText"
                               FontSize="14"
                               Foreground="#475569"
                               TextWrapping="Wrap"
                               LineHeight="23"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
