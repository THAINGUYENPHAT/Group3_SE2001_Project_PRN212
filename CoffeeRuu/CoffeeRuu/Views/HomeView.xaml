<UserControl x:Class="CoffeeRuu.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F0">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CoffeeBrown" Color="#4E342E"/>
        <SolidColorBrush x:Key="CoffeeDark" Color="#3B2A27"/>
        <SolidColorBrush x:Key="CoffeeLight" Color="#E9DFD9"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DED8D3"/>
        <SolidColorBrush x:Key="TextColor" Color="#3B2F2F"/>
        <SolidColorBrush x:Key="MutedText" Color="#817773"/>
        <SolidColorBrush x:Key="IconBackground" Color="#F2E8E2"/>

        <Style x:Key="HomeCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource CoffeeDark}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28">

            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="☕  Tổng quan"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="{StaticResource CoffeeDark}"/>

                <TextBlock x:Name="GreetingText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource CoffeeBrown}"
                           Margin="2,10,0,4"/>

                <TextBlock Text="Chào mừng bạn quay trở lại với CoffeeRuu. Chúc bạn có một ngày làm việc hiệu quả!"
                           FontSize="13"
                           Foreground="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="2,0,0,0"/>
            </StackPanel>

            <!-- Account Information -->
            <Border Style="{StaticResource HomeCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,22">
                        <Border Background="{StaticResource IconBackground}"
                                CornerRadius="8"
                                Width="44"
                                Height="44">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{StaticResource CoffeeBrown}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Thông tin tài khoản"
                                       Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Thông tin nhân viên đang đăng nhập"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0">
                            <TextBlock Text="Họ và tên"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding FullName}"
                                       Style="{StaticResource FieldValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="2">
                            <TextBlock Text="Mã nhân viên"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding EmployeeId}"
                                       Style="{StaticResource FieldValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0">
                            <TextBlock Text="Tên đăng nhập"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding Username}"
                                       Style="{StaticResource FieldValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="2">
                            <TextBlock Text="Vai trò"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding RoleName}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource CoffeeBrown}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About CoffeeRuu -->
            <Border Style="{StaticResource HomeCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,14">
                        <Border Background="{StaticResource IconBackground}"
                                CornerRadius="8"
                                Width="40"
                                Height="40">
                            <TextBlock Text="&#xE71D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="21"
                                       Foreground="{StaticResource CoffeeBrown}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Giới thiệu CoffeeRuu"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="12,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="CoffeeRuu là hệ thống quản lý quán cà phê, hỗ trợ quản lý sản phẩm, đơn hàng, bàn, kho nguyên liệu và tài khoản nhân viên. Hệ thống cung cấp các chức năng theo quyền hạn của từng vai trò, giúp các hoạt động trong quán được quản lý thuận tiện và nhất quán."
                               FontSize="13"
                               Foreground="{StaticResource TextColor}"
                               TextWrapping="Wrap"
                               LineHeight="23"/>
                </StackPanel>
            </Border>

            <!-- Role-specific Information -->
            <Border Style="{StaticResource HomeCard}"
                    Margin="0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,14">
                        <Border Background="{StaticResource IconBackground}"
                                CornerRadius="8"
                                Width="40"
                                Height="40">
                            <TextBlock Text="&#xE8D4;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="21"
                                       Foreground="{StaticResource CoffeeBrown}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Chức năng dành cho bạn"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="12,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="RoleTitleText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource CoffeeBrown}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <TextBlock x:Name="RoleDescriptionText"
                               FontSize="13"
                               Foreground="{StaticResource TextColor}"
                               TextWrapping="Wrap"
                               LineHeight="23"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
