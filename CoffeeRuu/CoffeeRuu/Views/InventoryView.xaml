 <Page x:Class="CoffeeRuu.Views.InventoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F0">

    <Page.Resources>
        <SolidColorBrush x:Key="CoffeeBrown" Color="#4E342E"/>
        <SolidColorBrush x:Key="CoffeeDark" Color="#3B2A27"/>
        <SolidColorBrush x:Key="CoffeeLight" Color="#E9DFD9"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DED8D3"/>
        <SolidColorBrush x:Key="MutedText" Color="#817773"/>

        <!-- TabControl -->
        <Style x:Key="CoffeeTabControl"
               TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CoffeeDark}"/>
        </Style>

        <!-- TabItem -->
        <Style x:Key="CoffeeTabItem"
               TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="#F0E9E4"/>
            <Setter Property="Foreground" Value="{StaticResource CoffeeBrown}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7,7,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{StaticResource CoffeeBrown}"/>
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource CoffeeBrown}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Opacity" Value="0.88"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder"
                                        Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    Margin="4,0,0,20">
            <TextBlock Text="☕  Quản lý kho"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="{StaticResource CoffeeDark}"/>

            <TextBlock Text="Quản lý nguyên liệu, nhà cung cấp, nhập hàng và cảnh báo tồn kho."
                       FontSize="13"
                       Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="2,6,0,0"/>
        </StackPanel>

        <!-- Inventory Tabs -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">

            <TabControl Style="{StaticResource CoffeeTabControl}"
                        ItemContainerStyle="{StaticResource CoffeeTabItem}">

                <TabItem Header="Nguyên liệu">
                    <Frame x:Name="IngredientFrame"
                           NavigationUIVisibility="Hidden"
                           Background="White"
                           BorderThickness="0"/>
                </TabItem>

                <TabItem Header="Nhà cung cấp">
                    <Frame x:Name="SupplierFrame"
                           NavigationUIVisibility="Hidden"
                           Background="White"
                           BorderThickness="0"/>
                </TabItem>

                <TabItem Header="Nhập hàng">
                    <Frame x:Name="StockReceiptFrame"
                           NavigationUIVisibility="Hidden"
                           Background="White"
                           BorderThickness="0"/>
                </TabItem>

                <TabItem Header="Cảnh báo tồn kho">
                    <Frame x:Name="LowStockAlertFrame"
                           NavigationUIVisibility="Hidden"
                           Background="White"
                           BorderThickness="0"/>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</Page>
