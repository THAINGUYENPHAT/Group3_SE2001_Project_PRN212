<Page x:Class="CoffeeRuu.Views.KdsOrderListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F0"
      Title="KDS - Pha chế">

    <Page.Resources>

        <!-- STYLE CHUNG CHO NÚT -->
        <Style x:Key="KdsButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- MÀU TRẠNG THÁI MÓN -->
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,9"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="BorderBrush" Value="#EEE9E5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>

            <Style.Triggers>

                <!-- CHỜ PHA -->
                <DataTrigger Binding="{Binding PreparationStatus}"
                             Value="Queued">
                    <Setter Property="Background"
                            Value="#FFF8E9"/>
                </DataTrigger>

                <!-- ĐANG PHA -->
                <DataTrigger Binding="{Binding PreparationStatus}"
                             Value="Preparing">
                    <Setter Property="Background"
                            Value="#EAF3FF"/>
                </DataTrigger>

                <!-- DÒNG ĐƯỢC CHỌN -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"
                            Value="#D8C4B7"/>
                </Trigger>

            </Style.Triggers>
        </Style>

    </Page.Resources>

    <!-- BỐ CỤC CHÍNH -->
    <Grid Margin="18,12,18,12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================= -->
        <!-- 1. TIÊU ĐỀ KDS -->
        <!-- ======================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">

            <TextBlock Text="KDS - Pha chế"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#3B2A27"/>

            <TextBlock
                Text="Quản lý đơn hàng và cập nhật trạng thái pha chế."
                FontSize="12"
                Foreground="#8A7770"
                Margin="0,4,0,0"/>

        </StackPanel>


        <!-- 2. NHÂN VIÊN VÀ THAO TÁC -->
        <Border Grid.Row="1"
        Background="White"
        CornerRadius="10"
        BorderBrush="#DED8D3"
        BorderThickness="1"
        Padding="14"
        Margin="0,0,0,12">

            <StackPanel>

                <!-- TÀI KHOẢN ĐANG ĐĂNG NHẬP -->
                <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,8">

                    <TextBlock Text="Đang đăng nhập: "
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#4E342E"/>

                    <TextBlock
                Text="{Binding CurrentEmployeeDisplay}"
                FontSize="12"
                Foreground="#657D54"/>
                </StackPanel>

                <!-- THÔNG BÁO PHÂN QUYỀN -->
                <TextBlock
            Text="{Binding KdsPermissionMessage}"
            FontSize="12"
            Foreground="#8A7770"
            Margin="0,0,0,12"/>

                <WrapPanel Orientation="Horizontal">

                    <!-- DANH SÁCH BARISTA CHỈ ĐỂ XEM -->
                    <TextBlock
                Text="Danh sách Barista:"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#3B2A27"
                VerticalAlignment="Center"
                Margin="0,0,8,8"/>

                    <ComboBox
                Width="250"
                Height="36"
                ItemsSource="{Binding Employees}"
                SelectedItem="{Binding SelectedEmployee,
                                       Mode=TwoWay}"
                DisplayMemberPath="DisplayName"
                Background="#FAF8F6"
                BorderBrush="#DED8D3"
                Margin="0,0,16,8"
                ToolTip="Chỉ xem danh sách, không thay đổi tài khoản thao tác"/>

                    <!-- LÀM MỚI -->
                    <Button
                Content="Làm mới"
                Command="{Binding RefreshCommand}"
                Background="#E9DFD9"
                Foreground="#4E342E"
                Style="{StaticResource KdsButton}"/>

                    <!-- BẮT ĐẦU PHA -->
                    <Button
                Content="Bắt đầu pha"
                Command="{Binding StartCommand}"
                IsEnabled="{Binding CanStart}"
                Background="#4E342E"
                Style="{StaticResource KdsButton}"/>

                    <!-- PHA XONG -->
                    <Button
                Content="Pha xong"
                Command="{Binding ReadyCommand}"
                IsEnabled="{Binding CanReady}"
                Background="#657D54"
                Style="{StaticResource KdsButton}"/>

                </WrapPanel>

            </StackPanel>
        </Border>


        <!-- ======================= -->
        <!-- 3. DANH SÁCH KDS -->
        <!-- ======================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                BorderBrush="#DED8D3"
                BorderThickness="1"
                Padding="14">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TIÊU ĐỀ DANH SÁCH -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">

                    <TextBlock
                        Text="Danh sách đơn cần pha chế"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#3B2A27"/>

                    <TextBlock
                        Text="Món đã pha xong sẽ tự động ẩn khỏi danh sách."
                        FontSize="12"
                        Foreground="#8A7770"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <!-- ======================= -->
                <!-- BỘ LỌC KDS -->
                <!-- ======================= -->

                <Border Grid.Row="1"
                        Background="#FAF8F6"
                        BorderBrush="#EEE8E2"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="10"
                        Margin="0,0,0,12">

                    <WrapPanel Orientation="Horizontal">

                        <!-- TÌM MÃ ĐƠN HOẶC TÊN MÓN -->
                        <StackPanel Margin="0,0,12,8">

                            <TextBlock
                                Text="Tìm mã đơn hoặc tên món"
                                Foreground="#8A7770"
                                FontSize="11"
                                Margin="0,0,0,4"/>

                            <TextBox Width="235"
                                     Height="35"
                                     Padding="9,4"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchKds,
                                             UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <!-- LỌC TRẠNG THÁI -->
                        <StackPanel Margin="0,0,12,8">

                            <TextBlock
                                Text="Trạng thái pha chế"
                                Foreground="#8A7770"
                                FontSize="11"
                                Margin="0,0,0,4"/>

                            <ComboBox Width="160"
                                      Height="35"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding FilterStatus,
                                                             Mode=TwoWay}"/>

                        </StackPanel>

                    </WrapPanel>

                </Border>

                <!-- ======================= -->
                <!-- DANH SÁCH MÓN -->
                <!-- ======================= -->

                <ListView Grid.Row="2"
                          ItemsSource="{Binding FilteredItems}"
                          SelectedItem="{Binding SelectedItem,
                                                 Mode=TwoWay}"
                          Background="White"
                          BorderBrush="#DED8D3"
                          BorderThickness="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <!-- CÁC CỘT DỮ LIỆU -->
                    <ListView.View>

                        <GridView>

                            <GridViewColumn
                                Header="Tên món"
                                DisplayMemberBinding="{Binding ProductName}"
                                Width="235"/>

                            <GridViewColumn
                                Header="Size"
                                DisplayMemberBinding="{Binding SizeName}"
                                Width="85"/>

                            <GridViewColumn
                                Header="Số lượng"
                                DisplayMemberBinding="{Binding Quantity}"
                                Width="90"/>

                            <GridViewColumn
                                Header="Trạng thái"
                                DisplayMemberBinding="{Binding PreparationStatus}"
                                Width="120"/>

                            <GridViewColumn
                                Header="Ghi chú"
                                DisplayMemberBinding="{Binding Note}"
                                Width="280"/>

                        </GridView>

                    </ListView.View>

                    <!-- ======================= -->
                    <!-- GOM MÓN THEO MÃ ĐƠN -->
                    <!-- ======================= -->

                    <ListView.GroupStyle>

                        <GroupStyle>

                            <GroupStyle.ContainerStyle>

                                <Style TargetType="GroupItem">

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="GroupItem">

                                                <Expander IsExpanded="True"
                                                          Margin="0,4,0,8"
                                                          Background="#F8F4F1">

                                                    <Expander.Header>

                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Margin="8,8">

                                                            <TextBlock
                                                                Text="Mã đơn: "
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Foreground="#4E342E"/>

                                                            <TextBlock
                                                                Text="{Binding Name}"
                                                                FontSize="13"
                                                                FontWeight="Bold"
                                                                Foreground="#4E342E"/>

                                                            <TextBlock
                                                                Text="{Binding ItemCount,
                                                                       StringFormat='  |  Số dòng món: {0}'}"
                                                                FontSize="12"
                                                                Foreground="#8A7770"
                                                                Margin="12,0,0,0"/>

                                                        </StackPanel>

                                                    </Expander.Header>

                                                    <ItemsPresenter Margin="4,4,4,8"/>

                                                </Expander>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </GroupStyle.ContainerStyle>

                        </GroupStyle>

                    </ListView.GroupStyle>

                </ListView>

            </Grid>

        </Border>

        <!-- ======================= -->
        <!-- 4. THÔNG BÁO -->
        <!-- ======================= -->

        <TextBlock Grid.Row="3"
                   Text="{Binding Message}"
                   FontSize="12"
                   Foreground="#A34F36"
                   Margin="4,8,0,0"
                   TextWrapping="Wrap"/>

    </Grid>

</Page>
