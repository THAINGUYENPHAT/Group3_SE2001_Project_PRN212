 <Page x:Class="CoffeeRuu.Views.KdsOrderListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F5F5F0"
      Loaded="Page_Loaded"
      Title="KdsOrderListView">

    <Page.Resources>
        <SolidColorBrush x:Key="CoffeeBrown" Color="#4E342E"/>
        <SolidColorBrush x:Key="CoffeeDark" Color="#3B2A27"/>
        <SolidColorBrush x:Key="CoffeeLight" Color="#E9DFD9"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DED8D3"/>
        <SolidColorBrush x:Key="TextColor" Color="#3B2F2F"/>
        <SolidColorBrush x:Key="MutedText" Color="#817773"/>

        <!-- Nut chinh -->
        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource CoffeeBrown}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nut phu -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="{StaticResource CoffeeBrown}"/>
        </Style>

        <!-- Nut xoa -->
        <Style x:Key="DeleteButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#A64F46"/>
        </Style>

        <!-- Danh sach mon -->
        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Padding" Value="8,9"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderBrush" Value="#EEE9E5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PreparationStatus}" Value="Queued">
                    <Setter Property="Background" Value="#FFF8E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PreparationStatus}" Value="Preparing">
                    <Setter Property="Background" Value="#F0E7D9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PreparationStatus}" Value="Ready">
                    <Setter Property="Background" Value="#E8F1E7"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E4D4CA"/>
                    <Setter Property="Foreground" Value="{StaticResource CoffeeDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Tieu de cot -->
        <Style x:Key="KdsGridViewColumnHeader"
               TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="{StaticResource CoffeeBrown}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderBrush" Value="#D7C9C1"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="☕  KDS - Pha chế"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="{StaticResource CoffeeDark}"/>

            <TextBlock Text="Quản lý đơn hàng và cập nhật trạng thái pha chế."
                       FontSize="13"
                       Foreground="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="2,6,0,0"/>
        </StackPanel>

        <!-- Thanh cong cu -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,18">

            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <TextBlock Text="Thông tin nhân viên"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource CoffeeDark}"
                               VerticalAlignment="Center"/>

                    <Border DockPanel.Dock="Right"
                            Background="#F2E8E2"
                            CornerRadius="6"
                            Padding="12,7">
                        <TextBlock Foreground="{StaticResource CoffeeBrown}"
                                   FontSize="12"
                                   FontWeight="SemiBold">
                            <Run Text="Mã NV: "/>
                            <Run Text="{Binding EmployeeIdText, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </DockPanel>

                <WrapPanel>
                    <Button Content="Nhập EmployeeID"
                            Click="EnterEmployeeId_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <Button Content="Làm mới"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>

                    <Button Content="Bắt đầu pha"
                            Command="{Binding StartCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <Button Content="Pha xong"
                            Command="{Binding ReadyCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="#647B52"/>

                    <Button Content="Xóa món"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource DeleteButtonStyle}"
                            Margin="0,0,0,8"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Danh sach don -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18">

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="Danh sách đơn cần pha chế"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{StaticResource CoffeeDark}"/>

                    <TextBlock Text="Chọn món trong đơn để cập nhật trạng thái xử lý."
                               FontSize="12"
                               Foreground="{StaticResource MutedText}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <ListView ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          BorderBrush="{StaticResource BorderColor}"
                          BorderThickness="1"
                          Background="White"
                          Foreground="{StaticResource TextColor}"
                          FontSize="12"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <!-- Nhom theo ma don -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="False"
                                                          HorizontalAlignment="Stretch"
                                                          Background="#F8F4F0"
                                                          BorderBrush="{StaticResource BorderColor}"
                                                          BorderThickness="1"
                                                          Margin="0,0,0,10"
                                                          Padding="8">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="8,6">
                                                            <TextBlock Text="Mã đơn: "
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource CoffeeBrown}"/>

                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource CoffeeDark}"/>

                                                            <TextBlock Text="  |  Số dòng món: "
                                                                       Foreground="{StaticResource MutedText}"
                                                                       Margin="12,0,0,0"/>

                                                            <TextBlock Text="{Binding ItemCount}"
                                                                       Foreground="{StaticResource MutedText}"/>
                                                        </StackPanel>
                                                    </Expander.Header>

                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <!-- Cac cot -->
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource KdsGridViewColumnHeader}">
                            <GridViewColumn Header="Tên món"
                                            DisplayMemberBinding="{Binding ProductName}"
                                            Width="190"/>

                            <GridViewColumn Header="Size"
                                            DisplayMemberBinding="{Binding SizeName}"
                                            Width="90"/>

                            <GridViewColumn Header="Số lượng"
                                            DisplayMemberBinding="{Binding Quantity}"
                                            Width="85"/>

                            <GridViewColumn Header="Trạng thái"
                                            DisplayMemberBinding="{Binding PreparationStatus}"
                                            Width="110"/>

                            <GridViewColumn Header="Ghi chú" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Note}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Padding="0,5"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- Thong bao -->
        <Border Grid.Row="3"
                Background="#F2E8E2"
                CornerRadius="6"
                Padding="12,9"
                Margin="0,14,0,0">
            <TextBlock Text="{Binding Message}"
                       Foreground="{StaticResource CoffeeBrown}"
                       TextWrapping="Wrap"
                       FontSize="12"/>
        </Border>
    </Grid>
</Page>
