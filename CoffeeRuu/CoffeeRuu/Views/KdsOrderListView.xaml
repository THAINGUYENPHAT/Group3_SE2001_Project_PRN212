<Page x:Class="CoffeeRuu.Views.KdsOrderListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F0"
      Loaded="Page_Loaded">

    <Page.Resources>

        <!-- STYLE CHUNG CHO NÚT -->
        <Style x:Key="KdsButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <!-- BỐ CỤC CHÍNH -->
    <Grid Margin="18,12,18,12">

        <Grid.RowDefinitions>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>

            <!-- Nhân viên và thao tác -->
            <RowDefinition Height="Auto"/>

            <!-- Danh sách chiếm không gian còn lại -->
            <RowDefinition Height="*"/>

            <!-- Thông báo -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TIÊU ĐỀ KDS -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,12">

            <TextBlock Text="KDS - Pha chế"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#3B2A27"/>

            <TextBlock
                Text="Quản lý đơn hàng và cập nhật trạng thái pha chế."
                FontSize="12"
                Foreground="#8A7770"
                Margin="0,4,0,0"/>

        </StackPanel>

        <!-- 2. THANH THÔNG TIN VÀ THAO TÁC -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                BorderBrush="#DED8D3"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,12">

            <WrapPanel Orientation="Horizontal"
                       VerticalAlignment="Center">

                <TextBlock Text="Mã NV:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#3B2A27"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8"/>

                <!-- HIỂN THỊ EMPLOYEEID -->
                <Border Background="#F2E8E3"
                        CornerRadius="5"
                        Height="36"
                        Width="75"
                        Margin="0,0,12,8">

                    <TextBlock
                        Text="{Binding EmployeeIdText}"
                        FontSize="13"
                        Foreground="#4E342E"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>

                </Border>

                <!-- NHẬP EMPLOYEEID -->
                <Button Content="Nhập EmployeeID"
                        Click="EnterEmployeeId_Click"
                        Background="#4E342E"
                        Style="{StaticResource KdsButton}"/>

                <!-- LÀM MỚI -->
                <Button Content="Làm mới"
                        Command="{Binding RefreshCommand}"
                        Background="#E9DFD9"
                        Foreground="#4E342E"
                        Style="{StaticResource KdsButton}"/>

                <!-- BẮT ĐẦU PHA -->
                <Button Content="Bắt đầu pha"
                        Command="{Binding StartCommand}"
                        Background="#4E342E"
                        Style="{StaticResource KdsButton}"/>

                <!-- PHA XONG -->
                <Button Content="Pha xong"
                        Command="{Binding ReadyCommand}"
                        Background="#657D54"
                        Style="{StaticResource KdsButton}"/>

            </WrapPanel>

        </Border>

        <!-- 3. DANH SÁCH ĐƠN CẦN PHA CHẾ -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                BorderBrush="#DED8D3"
                BorderThickness="1"
                Padding="14">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TIÊU ĐỀ DANH SÁCH -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">

                    <TextBlock
                        Text="Danh sách đơn cần pha chế"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#3B2A27"/>

                    <TextBlock
                        Text="Chọn món trong đơn để cập nhật trạng thái xử lý."
                        FontSize="12"
                        Foreground="#8A7770"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <!-- DANH SÁCH MÓN -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem,
                                         Mode=TwoWay}"
                          Background="White"
                          BorderBrush="#DED8D3"
                          BorderThickness="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <!-- HIỂN THỊ MÓN -->
                    <ListView.View>
                        <GridView>

                            <GridViewColumn
                                Header="Tên món"
                                DisplayMemberBinding="{Binding ProductName}"
                                Width="235"/>

                            <GridViewColumn
                                Header="Size"
                                DisplayMemberBinding="{Binding SizeName}"
                                Width="85"/>

                            <GridViewColumn
                                Header="Số lượng"
                                DisplayMemberBinding="{Binding Quantity}"
                                Width="90"/>

                            <GridViewColumn
                                Header="Trạng thái"
                                DisplayMemberBinding="{Binding PreparationStatus}"
                                Width="120"/>

                            <GridViewColumn
                                Header="Ghi chú"
                                DisplayMemberBinding="{Binding Note}"
                                Width="280"/>

                        </GridView>
                    </ListView.View>

                    <!-- NHÓM THEO MÃ ĐƠN -->
                    <ListView.GroupStyle>
                        <GroupStyle>

                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">

                                    <Setter Property="Template">
                                        <Setter.Value>

                                            <ControlTemplate TargetType="GroupItem">

                                                <Expander IsExpanded="False"
                                                          Margin="0,4,0,8"
                                                          Background="#F8F4F1">

                                                    <Expander.Header>
                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Margin="8,8">

                                                            <TextBlock
                                                                Text="Mã đơn: "
                                                                FontSize="13"
                                                                FontWeight="SemiBold"
                                                                Foreground="#4E342E"/>

                                                            <TextBlock
                                                                Text="{Binding Name}"
                                                                FontSize="13"
                                                                FontWeight="Bold"
                                                                Foreground="#4E342E"/>

                                                            <TextBlock
                                                                Text="{Binding ItemCount,
                                                                       StringFormat='  |  Số dòng món: {0}'}"
                                                                FontSize="12"
                                                                Foreground="#8A7770"
                                                                Margin="12,0,0,0"/>

                                                        </StackPanel>
                                                    </Expander.Header>

                                                    <ItemsPresenter
                                                        Margin="4,4,4,8"/>

                                                </Expander>

                                            </ControlTemplate>

                                        </Setter.Value>
                                    </Setter>

                                </Style>
                            </GroupStyle.ContainerStyle>

                        </GroupStyle>
                    </ListView.GroupStyle>

                </ListView>

            </Grid>

        </Border>

        <!-- 4. THÔNG BÁO -->
        <TextBlock Grid.Row="3"
                   Text="{Binding Message}"
                   FontSize="12"
                   Foreground="#A34F36"
                   Margin="4,8,0,0"
                   TextWrapping="Wrap"/>

    </Grid>
</Page>
