<Page x:Class="CoffeeRuu.Views.OrderCreateView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoffeeRuu.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderCreateView">

    <Page.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#433431"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- THÔNG TIN ĐƠN HÀNG -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,15,0">

            <Border Background="White"
                    Padding="18"
                    CornerRadius="10">

                <StackPanel>
                    <TextBlock Text="Tạo đơn hàng"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#433431"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="Mã nhân viên"
                               Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding EmployeeIdText,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Loại đơn"
                               Margin="0,0,0,6"/>
                    <ComboBox Height="35"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding OrderTypes}"
                              SelectedItem="{Binding OrderType}"/>

                    <TextBlock Text="Chọn bàn"
                               Margin="0,0,0,6"/>
                    <ComboBox Height="35"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding Tables}"
                              SelectedItem="{Binding SelectedTable}"
                              DisplayMemberPath="TableName"
                              IsEnabled="{Binding IsDineIn}"/>

                    <TextBlock Text="Sản phẩm / Size"
                               Margin="0,0,0,6"/>
                    <ComboBox Height="35"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding Menu}"
                              SelectedItem="{Binding SelectedMenu}"
                              DisplayMemberPath="Display"/>

                    <TextBlock Text="Số lượng"
                               Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding QuantityText,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Ghi chú món"
                               Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}"
                             MaxLength="300"
                             Text="{Binding ItemNote}"/>

                    <Button Content="Thêm vào đơn"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- GIỎ HÀNG -->
        <Border Grid.Column="1"
                Background="White"
                Padding="18"
                CornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,15">

                    <Button DockPanel.Dock="Right"
                            Content="Xóa món"
                            Command="{Binding RemoveCommand}"
                            Padding="12,7"/>

                    <TextBlock Text="Chi tiết đơn hàng"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#433431"/>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Cart}"
                          SelectedItem="{Binding SelectedCart}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="Tên món"
                            Binding="{Binding ProductName}"
                            Width="*"/>

                        <DataGridTextColumn
                            Header="Size"
                            Binding="{Binding SizeName}"
                            Width="70"/>

                        <DataGridTextColumn
                            Header="SL"
                            Binding="{Binding Quantity}"
                            Width="50"/>

                        <DataGridTextColumn
                            Header="Thành tiền"
                            Binding="{Binding LineTotal,
                                      StringFormat={}{0:N0}}"
                            Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2"
                            Margin="0,18,0,0">

                    <TextBlock Text="Ghi chú đơn"
                               Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding OrderNote}"/>

                    <TextBlock
                        Text="{Binding CartTotal,
                               StringFormat=Tổng cộng: {0:N0} đ}"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#433431"
                        Margin="0,0,0,12"/>

                    <Button Content="Xác nhận tạo đơn"
                            Command="{Binding CreateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <TextBlock Text="{Binding Message}"
                               Foreground="#A34F36"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
