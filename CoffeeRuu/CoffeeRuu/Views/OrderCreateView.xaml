<Page x:Class="CoffeeRuu.Views.OrderCreateView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CoffeeRuu.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Background="#F5F5F0"
      Title="OrderCreateView">

    <Page.Resources>
        <!-- Ô nhập liệu -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Danh sách chọn -->
        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Nút chính -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4E342E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#6D4C41"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3B2A27"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút phụ -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
        </Style>

        <!-- Tiêu đề các ô nhập -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5D4942"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Tiêu đề cột bảng -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Ô dữ liệu -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- Dòng dữ liệu -->
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFE3DC"/>
                    <Setter Property="Foreground" Value="#3B2A27"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- THÔNG TIN ĐƠN HÀNG -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,16,0">

            <Border Background="White"
                    Padding="20"
                    CornerRadius="8"
                    BorderBrush="#DED8D3"
                    BorderThickness="1">

                <StackPanel>
                    <TextBlock Text="Tạo đơn hàng"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#3B2A27"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="Nhập thông tin và chọn món"
                               FontSize="12"
                               Foreground="#82736D"
                               Margin="0,0,0,22"/>

                    <TextBlock Text="Mã nhân viên"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding EmployeeIdText,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Loại đơn"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox Height="38"
                              Margin="0,0,0,14"
                              Style="{StaticResource InputComboBoxStyle}"
                              ItemsSource="{Binding OrderTypes}"
                              SelectedItem="{Binding OrderType}"/>

                    <TextBlock Text="Chọn bàn"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox Height="38"
                              Margin="0,0,0,14"
                              Style="{StaticResource InputComboBoxStyle}"
                              ItemsSource="{Binding Tables}"
                              SelectedItem="{Binding SelectedTable}"
                              DisplayMemberPath="TableName"
                              IsEnabled="{Binding IsDineIn}"/>

                    <TextBlock Text="Sản phẩm / Size"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox Height="38"
                              Margin="0,0,0,14"
                              Style="{StaticResource InputComboBoxStyle}"
                              ItemsSource="{Binding Menu}"
                              SelectedItem="{Binding SelectedMenu}"
                              DisplayMemberPath="Display"/>

                    <TextBlock Text="Số lượng"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding QuantityText,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Ghi chú món"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource InputStyle}"
                             MaxLength="300"
                             Text="{Binding ItemNote}"
                             Height="64"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"/>

                    <Button Content="＋  Thêm vào đơn"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- GIỎ HÀNG -->
        <Border Grid.Column="1"
                Background="White"
                Padding="20"
                CornerRadius="8"
                BorderBrush="#DED8D3"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề giỏ hàng -->
                <DockPanel Grid.Row="0"
                           Margin="0,0,0,16"
                           LastChildFill="True">

                    <Button DockPanel.Dock="Right"
                            Content="Xóa món"
                            Command="{Binding RemoveCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,7"
                            MinHeight="34"
                            Margin="12,0,0,0"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chi tiết đơn hàng"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#3B2A27"/>

                        <TextBlock Text="Danh sách món đã chọn"
                                   FontSize="12"
                                   Foreground="#82736D"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Bảng món đã chọn -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Cart}"
                          SelectedItem="{Binding SelectedCart}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          RowHeight="42"
                          FontSize="13"
                          Foreground="#3B2A27"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAF8F5"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEE8E2"
                          VerticalGridLinesBrush="#F0EBE6"
                          BorderBrush="#DED8D3"
                          BorderThickness="1"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên món"
                                            Binding="{Binding ProductName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Size"
                                            Binding="{Binding SizeName}"
                                            Width="70"/>

                        <DataGridTextColumn Header="SL"
                                            Binding="{Binding Quantity}"
                                            Width="50"/>

                        <DataGridTextColumn Header="Thành tiền"
                                            Binding="{Binding LineTotal,
                                                      StringFormat={}{0:N0}}"
                                            Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tổng tiền và xác nhận -->
                <StackPanel Grid.Row="2"
                            Margin="0,18,0,0">

                    <TextBlock Text="Ghi chú đơn"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource InputStyle}"
                             Text="{Binding OrderNote}"
                             Height="54"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"/>

                    <Border Background="#F5F0EB"
                            CornerRadius="6"
                            Padding="14,12"
                            Margin="0,0,0,14">

                        <DockPanel>
                            <TextBlock Text="Tổng cộng"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#5D4942"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="{Binding CartTotal,
                                              StringFormat={}{0:N0} đ}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#4E342E"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Button Content="Xác nhận tạo đơn"
                            Command="{Binding CreateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <TextBlock Text="{Binding Message}"
                               Foreground="#A34F36"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>