<UserControl x:Class="CoffeeRuu.Views.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <UserControl.Resources>
        <!-- Style cho Textbox và ComboBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Style chung cho Button (Bo góc) -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D1D5DB"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6.5*"/>
            <ColumnDefinition Width="3.5*"/>
        </Grid.ColumnDefinitions>

        <!-- KHU VỰC DANH SÁCH BÀN -->
        <!-- Đã sửa: Thêm Padding="15" vào Border và xóa khỏi Grid -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="0,0,15,0" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Danh sách bàn" FontSize="20" FontWeight="Bold" Foreground="#1F2937" Margin="5,0,0,15"/>

                <DataGrid Grid.Row="1" AutoGenerateColumns="False" 
                          ItemsSource="{Binding Tables}" 
                          SelectedItem="{Binding SelectedTable}" 
                          IsReadOnly="True" 
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          RowHeight="40"
                          Background="White"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#F9FAFB">
                    <DataGrid.Resources>
                        <!-- Style làm đẹp Header của DataGrid -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#4B5563"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                        <!-- Style Cell -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                       <!-- <DataGridTextColumn Header="ID" Binding="{Binding TableId}" Width="60"/-->
                        <DataGridTextColumn Header="Tên bàn" Binding="{Binding TableName}" Width="*"/>
                        <DataGridTextColumn Header="Sức chứa" Binding="{Binding Capacity}" Width="100"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TableStatus}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- KHU VỰC FORM NHẬP LIỆU -->
        <!-- Đã sửa: Thêm Padding="25" vào Border và xóa khỏi StackPanel -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Thông tin chi tiết" FontSize="20" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,25"/>

                <!-- Tên Bàn -->
                <TextBlock Text="Tên / Số bàn:" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                <TextBox Text="{Binding TableNameInput, Mode=OneWay}" 
                         IsReadOnly="True" 
                         Background="#F9FAFB"
                         Foreground="#6B7280"
                         Height="36" 
                         Margin="0,0,0,20" 
                         VerticalContentAlignment="Center"/>

                <!-- Sức chứa -->
                <TextBlock Text="Sức chứa (Số ghế):" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                <TextBox Text="{Binding CapacityInput, UpdateSourceTrigger=PropertyChanged}" 
                         Height="36" 
                         Margin="0,0,0,20" 
                         VerticalContentAlignment="Center"/>

                <!-- Trạng thái -->
                <TextBlock Text="Trạng thái:" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding StatusList}" 
                          SelectedItem="{Binding StatusInput, UpdateSourceTrigger=PropertyChanged}" 
                          Height="36" 
                          Margin="0,0,0,25" 
                          VerticalContentAlignment="Center"/>

                <!-- Thông báo -->
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="#EF4444" 
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" 
                           Margin="0,0,0,15"
                           HorizontalAlignment="Center"/>

                <!-- Các nút thao tác -->
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="Thêm mới" 
                            Command="{Binding AddCommand}" 
                            Style="{StaticResource ModernButton}" 
                            Background="#10B981" Width="100"/>

                    <Button Content="Cập nhật" 
                            Command="{Binding UpdateCommand}" 
                            Style="{StaticResource ModernButton}" 
                            Background="#3B82F6" Width="100"/>

                    <Button Content="Xóa" 
                            Command="{Binding DeleteCommand}" 
                            Style="{StaticResource ModernButton}" 
                            Background="#EF4444" Width="100"/>

                    <Button Content="Làm mới" 
                            Command="{Binding ClearCommand}" 
                            Style="{StaticResource ModernButton}" 
                            Background="#6B7280" Width="100"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>