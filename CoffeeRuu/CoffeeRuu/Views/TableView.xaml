<UserControl x:Class="CoffeeRuu.Views.TableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F0">

    <UserControl.Resources>

        <!-- TEXTBOX -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="BorderBrush" Value="#D8CEC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- COMBOBOX -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="BorderBrush" Value="#D8CEC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- BUTTON CHINH -->
        <Style x:Key="ModernButton"
               TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATA GRID -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="BorderBrush" Value="#E8E0DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#FAF8F6"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEE7E2"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- DATA GRID HEADER -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DATA GRID CELL -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CARD -->
        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E8E0DA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- KHU VUC DANH SACH BAN -->
        <Border Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,20">
                    <TextBlock Text="Quản lý bàn"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#3B2A27"/>

                    <TextBlock Text="Danh sách bàn và tình trạng sử dụng"
                               FontSize="13"
                               Foreground="#82736C"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <!-- SECTION TITLE -->
                <Border Grid.Row="1"
                        Background="#F8F3EF"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,14">

                    <TextBlock Text="Danh sách bàn"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#4E342E"/>
                </Border>

                <!-- TABLE GRID -->
                <DataGrid Grid.Row="2"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding Tables}"
                          SelectedItem="{Binding SelectedTable}"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="1"
                          RowHeight="44"
                          ColumnHeaderHeight="44"
                          Background="White"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#FAF8F6">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="Tên bàn"
                            Binding="{Binding TableName}"
                            Width="*"/>

                        <DataGridTextColumn
                            Header="Sức chứa"
                            Binding="{Binding Capacity}"
                            Width="95"/>

                        <DataGridTextColumn
                            Header="Trạng thái"
                            Binding="{Binding TableStatus}"
                            Width="115"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- KHU VUC FORM THONG TIN -->
        <Border Grid.Column="2"
                Style="{StaticResource CardStyle}"
                Padding="22">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <!-- HEADER -->
                    <TextBlock Text="Thông tin chi tiết"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#3B2A27"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Xem và cập nhật thông tin bàn"
                               FontSize="12"
                               Foreground="#82736C"
                               Margin="0,0,0,24"/>

                    <!-- TEN BAN -->
                    <TextBlock Text="Tên / Số bàn"
                               FontWeight="SemiBold"
                               Foreground="#4E342E"
                               Margin="0,0,0,8"/>

                    <TextBox Text="{Binding TableNameInput, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="#F8F3EF"
                             Foreground="#82736C"
                             Height="38"
                             Margin="0,0,0,20"/>

                    <!-- SUC CHUA -->
                    <TextBlock Text="Sức chứa (số ghế)"
                               FontWeight="SemiBold"
                               Foreground="#4E342E"
                               Margin="0,0,0,8"/>

                    <TextBox Text="{Binding CapacityInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="38"
                             Margin="0,0,0,20"/>

                    <!-- TRANG THAI -->
                    <TextBlock Text="Trạng thái"
                               FontWeight="SemiBold"
                               Foreground="#4E342E"
                               Margin="0,0,0,8"/>

                    <ComboBox ItemsSource="{Binding StatusList}"
                              SelectedItem="{Binding StatusInput, UpdateSourceTrigger=PropertyChanged}"
                              Height="38"
                              Margin="0,0,0,22"/>

                    <!-- THONG BAO -->
                    <Border Background="#F8F3EF"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,20">

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#8A5145"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"/>
                    </Border>

                    <!-- ACTIONS -->
                    <TextBlock Text="Thao tác"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#4E342E"
                               Margin="0,0,0,12"/>

                    <WrapPanel>
                        <Button Content="Thêm mới"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource ModernButton}"
                                Background="#4E342E"
                                Width="112"/>

                        <Button Content="Cập nhật"
                                Command="{Binding UpdateCommand}"
                                Style="{StaticResource ModernButton}"
                                Background="#806451"
                                Width="112"/>

                        <Button Content="Xóa"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource ModernButton}"
                                Background="#A94438"
                                Width="112"/>

                        <Button Content="Làm mới"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource ModernButton}"
                                Background="#A69A91"
                                Width="112"/>
                    </WrapPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
