<Window x:Class="CoffeeRuu.Views.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoffeeRuu - Trang chủ"
        Height="650"
        Width="1100"
        MinHeight="550"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#3B2F2F">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="CoffeeRuu"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,10,0,5"/>

                    <TextBlock Text="{Binding CurrentUserName}"
                               FontSize="13"
                               Foreground="#E8DCDC"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding CurrentRoleName}"
                               FontSize="12"
                               Foreground="#D6BFAF"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="🏠  Trang chủ"
                                Height="42"
                                Margin="0,0,0,10"
                                Command="{Binding NavigateHomeCommand}"
                                Visibility="{Binding HomeVisibility}"/>

                        <Button Content="📃 Menu"
                                Height="42"
                                Margin="0,0,0,10"
                                Command="{Binding NavigateMenuCommand}"
                                Visibility="{Binding MenuVisibility}"/>

                        <Button Content="☕ Sản phẩm"
                                Height="42"
                                Margin="0,0,0,10"
                                Command="{Binding NavigateProductCommand}"
                                Visibility="{Binding ProductVisibility}"/>

                        <Button Content="🧾 Đơn hàng"
                                Height="42"
                                Margin="0,0,0,10"
                                Command="{Binding NavigateOrdersCommand}"
                                Visibility="{Binding OrdersVisibility}"/>

                        <Button Content="📺 KDS - Pha chế"
                                Height="42"
                                Margin="0,0,0,10"
                                Command="{Binding NavigateKdsCommand}"
                                Visibility="{Binding KdsVisibility}"/>

                        <Button Content="📦  Kho hàng"
                                Height="42"
                                Margin="0,0,0,10"
                                Command="{Binding InventoryCommand}"
                                Visibility="{Binding InventoryVisibility}"/>

                        <Button Content="📊  Báo cáo"
                                Height="42"
                                Margin="0,0,0,10"
                                Command="{Binding ReportCommand}"
                                Visibility="{Binding ReportVisibility}"/>

                        <Button Content="🪑  Quản lý Bàn"
                                Height="42"
                                Margin="0,0,0,10"
                                Command="{Binding TableCommand}"
                                Visibility="{Binding TableVisibility}"/>

                        <Button Content="👥  Nhân viên"
                                Height="42"
                                Margin="0,0,0,10"
                                Command="{Binding EmployeeCommand}"
                                Visibility="{Binding EmployeeVisibility}"/>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2"
                        Content="🚪  Đăng xuất"
                        Height="42"
                        Margin="0,10,0,10"
                        Command="{Binding LogoutCommand}"/>
            </Grid>
        </Border>

        <Frame x:Name="MainContent"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
