<Window x:Class="CoffeeRuu.Views.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoffeeRuu - Trang chủ"
        Height="650"
        Width="1100"
        MinHeight="550"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F0">

    <Window.Resources>

        <!-- Style gốc của nút menu -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5EEE9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Di chuột -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#5B443D"/>
                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>
                            </Trigger>

                            <!-- Trang đang mở -->
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#806052"/>
                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>

                            <!-- Khi nhấn -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#6D4C41"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Các style tự đánh dấu trang đang mở -->
        <Style x:Key="HomeSidebarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                    <Setter Property="Tag" Value="Active"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MenuSidebarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Menu">
                    <Setter Property="Tag" Value="Active"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProductSidebarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Product">
                    <Setter Property="Tag" Value="Active"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrdersSidebarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Orders">
                    <Setter Property="Tag" Value="Active"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KdsSidebarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="KDS">
                    <Setter Property="Tag" Value="Active"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InventorySidebarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Inventory">
                    <Setter Property="Tag" Value="Active"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportSidebarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Report">
                    <Setter Property="Tag" Value="Active"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TableSidebarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Table">
                    <Setter Property="Tag" Value="Active"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmployeeSidebarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPage}" Value="Employee">
                    <Setter Property="Tag" Value="Active"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Nút đăng xuất -->
        <Style x:Key="LogoutButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="#6B3732"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#853F38"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#512A26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#3B2A27">

            <Grid Margin="18,20,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Thông tin người dùng -->
                <StackPanel Grid.Row="0"
                            Margin="4,0,4,24">

                    <TextBlock Text="CoffeeRuu"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Margin="0,4,0,5"/>

                    <TextBlock Text="COFFEE MANAGEMENT"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#C9A99B"
                               Margin="1,0,0,20"/>

                    <Border Height="1"
                            Background="#624942"
                            Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding CurrentUserName}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding CurrentRoleName}"
                               FontSize="12"
                               Foreground="#D6BFAF"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Danh sách menu -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>
                        <TextBlock Text="MENU CHÍNH"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#BCA49A"
                                   Margin="8,0,0,12"/>

                        <Button Content="🏠   Trang chủ"
                                Style="{StaticResource HomeSidebarButtonStyle}"
                                Command="{Binding NavigateHomeCommand}"
                                Visibility="{Binding HomeVisibility}"/>

                        <Button Content="📃   Menu"
                                Style="{StaticResource MenuSidebarButtonStyle}"
                                Command="{Binding NavigateMenuCommand}"
                                Visibility="{Binding MenuVisibility}"/>

                        <Button Content="☕   Sản phẩm"
                                Style="{StaticResource ProductSidebarButtonStyle}"
                                Command="{Binding NavigateProductCommand}"
                                Visibility="{Binding ProductVisibility}"/>

                        <Button Content="🧾   Đơn hàng"
                                Style="{StaticResource OrdersSidebarButtonStyle}"
                                Command="{Binding NavigateOrdersCommand}"
                                Visibility="{Binding OrdersVisibility}"/>

                        <Button Content="📺   KDS - Pha chế"
                                Style="{StaticResource KdsSidebarButtonStyle}"
                                Command="{Binding NavigateKdsCommand}"
                                Visibility="{Binding KdsVisibility}"/>

                        <Button Content="📦   Kho hàng"
                                Style="{StaticResource InventorySidebarButtonStyle}"
                                Command="{Binding InventoryCommand}"
                                Visibility="{Binding InventoryVisibility}"/>

                        <Button Content="📊   Báo cáo"
                                Style="{StaticResource ReportSidebarButtonStyle}"
                                Command="{Binding ReportCommand}"
                                Visibility="{Binding ReportVisibility}"/>

                        <Button Content="🪑   Quản lý bàn"
                                Style="{StaticResource TableSidebarButtonStyle}"
                                Command="{Binding TableCommand}"
                                Visibility="{Binding TableVisibility}"/>

                        <Button Content="👥   Nhân viên"
                                Style="{StaticResource EmployeeSidebarButtonStyle}"
                                Command="{Binding EmployeeCommand}"
                                Visibility="{Binding EmployeeVisibility}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Đăng xuất -->
                <StackPanel Grid.Row="2">
                    <Border Height="1"
                            Background="#624942"
                            Margin="0,0,0,12"/>

                    <Button Content="🚪   Đăng xuất"
                            Style="{StaticResource LogoutButtonStyle}"
                            Height="42"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Nội dung trang -->
        <Border Grid.Column="1"
                Background="#F5F5F0"
                Padding="0">

            <Frame x:Name="MainContent"
                   NavigationUIVisibility="Hidden"
                   Background="#F5F5F0"/>
        </Border>
    </Grid>
</Window>
