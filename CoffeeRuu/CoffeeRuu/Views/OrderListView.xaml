<Page x:Class="CoffeeRuu.Views.OrderListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="700"
      d:DesignWidth="1100"
      Background="#F5F5F0"
      Title="Danh sách đơn hàng">

    <Page.Resources>

        <!-- CARD -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- NÚT CHÍNH -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4E342E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT LÀM MỚI -->
        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
        </Style>

        <!-- NÚT HỦY -->
        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background" Value="#AD5148"/>
        </Style>

        <!-- DATA GRID -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#EEE8E2"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <!-- TIÊU ĐỀ CỘT -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <!-- Ô DỮ LIỆU -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

    </Page.Resources>

    <!-- GIAO DIỆN CHÍNH -->
    <Grid Margin="18,12,18,12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">

            <TextBlock Text="Order Processing"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#3B2A27"/>

            <TextBlock
                Text="Theo dõi và xử lý các đơn hàng của quán."
                FontSize="12"
                Foreground="#8A7770"
                Margin="0,4,0,0"/>

        </StackPanel>

        <!-- 2. NHÂN VIÊN VÀ NÚT THAO TÁC -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,12">

            <WrapPanel Orientation="Horizontal"
                       VerticalAlignment="Center">

                <!-- DANH SÁCH NHÂN VIÊN -->
                <TextBlock Text="Nhân viên:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#3B2A27"
                           VerticalAlignment="Center"
                           Margin="0,0,8,8"/>

                <ComboBox Width="260"
                          Height="38"
                          DisplayMemberPath="DisplayName"
                          ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployee,
                                                 Mode=TwoWay}"
                          Background="#FAF8F6"
                          BorderBrush="#DED8D3"
                          Margin="0,0,16,8"/>

                <!-- LÀM MỚI -->
                <Button Content="Làm mới"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"/>

                <!-- BÀN GIAO -->
                <Button Content="Bàn giao"
                        Command="{Binding CompleteCommand}"
                        Style="{StaticResource PrimaryButton}"/>

                <!-- HỦY ĐƠN -->
                <Button Content="Hủy đơn mới"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource DangerButton}"/>

            </WrapPanel>

        </Border>

        <!-- 3. DANH SÁCH ĐƠN HÀNG -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TIÊU ĐỀ -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">

                    <TextBlock Text="Danh sách đơn hàng"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#3B2A27"/>

                    <TextBlock
                        Text="Chọn một đơn hàng để bàn giao hoặc hủy đơn mới."
                        FontSize="12"
                        Foreground="#8A7770"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <!-- BỘ LỌC ĐƠN HÀNG -->
                <Border Grid.Row="1"
                        Background="#FAF8F6"
                        BorderBrush="#EEE8E2"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="10"
                        Margin="0,0,0,12">

                    <WrapPanel VerticalAlignment="Center">

                        <!-- TÌM KIẾM MÃ ĐƠN -->
                        <StackPanel Margin="0,0,12,8">

                            <TextBlock Text="Tìm mã đơn"
                                       Foreground="#8A7770"
                                       FontSize="11"
                                       Margin="0,0,0,4"/>

                            <TextBox Width="210"
                                     Height="35"
                                     Padding="9,4"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchOrder,
                                             UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <!-- LỌC THEO TRẠNG THÁI -->
                        <StackPanel Margin="0,0,12,8">

                            <TextBlock Text="Trạng thái"
                                       Foreground="#8A7770"
                                       FontSize="11"
                                       Margin="0,0,0,4"/>

                            <ComboBox Width="150"
                                      Height="35"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding StatusFilter,
                                                             Mode=TwoWay}"/>

                        </StackPanel>

                        <!-- LỌC THEO NGÀY -->
                        <StackPanel Margin="0,0,12,8">

                            <TextBlock
                                Text="Ngày tạo đơn (để trống = tất cả)"
                                Foreground="#8A7770"
                                FontSize="11"
                                Margin="0,0,0,4"/>

                            <DatePicker Width="180"
                                        Height="35"
                                        SelectedDate="{Binding FilterDate,
                                                               Mode=TwoWay}"/>

                        </StackPanel>

                    </WrapPanel>
                </Border>

                <!-- BẢNG ĐƠN HÀNG -->
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding FilteredOrders}"
                          SelectedItem="{Binding SelectedOrder,
                                                 Mode=TwoWay}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <!-- MÀU TRẠNG THÁI -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">

                            <Setter Property="Background"
                                    Value="White"/>

                            <Setter Property="Foreground"
                                    Value="#3B2A27"/>

                            <Style.Triggers>

                                <!-- NEW -->
                                <DataTrigger
                                    Binding="{Binding OrderStatus}"
                                    Value="New">

                                    <Setter Property="Background"
                                            Value="#FFF8E7"/>
                                </DataTrigger>

                                <!-- PREPARING -->
                                <DataTrigger
                                    Binding="{Binding OrderStatus}"
                                    Value="Preparing">

                                    <Setter Property="Background"
                                            Value="#EAF3FF"/>
                                </DataTrigger>

                                <!-- READY -->
                                <DataTrigger
                                    Binding="{Binding OrderStatus}"
                                    Value="Ready">

                                    <Setter Property="Background"
                                            Value="#EAF8ED"/>
                                </DataTrigger>

                                <!-- COMPLETED -->
                                <DataTrigger
                                    Binding="{Binding OrderStatus}"
                                    Value="Completed">

                                    <Setter Property="Background"
                                            Value="#E5F5E9"/>
                                </DataTrigger>

                                <!-- CANCELLED -->
                                <DataTrigger
                                    Binding="{Binding OrderStatus}"
                                    Value="Cancelled">

                                    <Setter Property="Background"
                                            Value="#FDEEEE"/>
                                </DataTrigger>

                                <!-- DÒNG ĐANG CHỌN -->
                                <Trigger Property="IsSelected"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="#D8C4B7"/>

                                    <Setter Property="Foreground"
                                            Value="#3B2A27"/>
                                </Trigger>

                            </Style.Triggers>

                        </Style>
                    </DataGrid.RowStyle>

                    <!-- CÁC CỘT -->
                    <DataGrid.Columns>

                        <!-- MÃ ĐƠN -->
                        <DataGridTextColumn
                            Header="Mã đơn"
                            Binding="{Binding OrderCode}"
                            Width="2.3*"
                            MinWidth="150"/>

                        <!-- BÀN -->
                        <DataGridTextColumn
                            Header="Bàn"
                            Binding="{Binding TableName}"
                            Width="1*"
                            MinWidth="70"/>

                        <!-- LOẠI ĐƠN -->
                        <DataGridTextColumn
                            Header="Loại đơn"
                            Binding="{Binding OrderType}"
                            Width="1.1*"
                            MinWidth="90"/>

                        <!-- TRẠNG THÁI -->
                        <DataGridTextColumn
                            Header="Trạng thái"
                            Binding="{Binding OrderStatus}"
                            Width="1.1*"
                            MinWidth="100"/>

                        <!-- TỔNG TIỀN -->
                        <DataGridTextColumn
                            Header="Tổng tiền"
                            Binding="{Binding TotalAmount,
                                      StringFormat={}{0:N0}}"
                            Width="1*"
                            MinWidth="100"/>

                        <!-- THỜI GIAN -->
                        <DataGridTextColumn
                            Header="Thời gian"
                            Binding="{Binding CreatedAt,
                                      StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                            Width="1.5*"
                            MinWidth="135"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <!-- 4. THÔNG BÁO -->
        <TextBlock Grid.Row="3"
                   Text="{Binding Message}"
                   Foreground="#A34F36"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="4,8,0,0"/>

    </Grid>

</Page>
