<Page x:Class="CoffeeRuu.Views.OrderListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoffeeRuu.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderListView">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Danh sách đơn hàng"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#433431"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="18">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0"
                           Margin="0,0,0,15">

                    <Button Content="Làm mới"
                            Command="{Binding RefreshCommand}"
                            Padding="15,9"
                            Margin="0,0,10,0"/>

                    <Button Content="Bàn giao"
                            Command="{Binding CompleteCommand}"
                            Padding="15,9"
                            Margin="0,0,10,0"/>

                    <Button Content="Hủy đơn mới"
                            Command="{Binding CancelCommand}"
                            Padding="15,9"/>
                </WrapPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã đơn"
                                            Binding="{Binding OrderCode}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Bàn"
                                            Binding="{Binding TableName}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Loại đơn"
                                            Binding="{Binding OrderType}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Trạng thái"
                                            Binding="{Binding OrderStatus}"
                                            Width="110"/>

                        <DataGridTextColumn
                            Header="Tổng tiền"
                            Binding="{Binding TotalAmount,
                                      StringFormat={}{0:N0}}"
                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding Message}"
                   Foreground="#A34F36"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Page>
