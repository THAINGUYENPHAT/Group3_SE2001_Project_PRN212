<Page x:Class="CoffeeRuu.Views.OrderListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CoffeeRuu.Views"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Background="#F5F5F0"
      Title="OrderListView">

    <Page.Resources>
        <!-- Nút chính -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4E342E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#6D4C41"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#3B2A27"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút thao tác phụ -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
        </Style>

        <!-- Nút hủy đơn -->
        <Style x:Key="CancelButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#A33D32"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Tiêu đề bảng -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Ô dữ liệu -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- Dòng dữ liệu -->
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFE3DC"/>
                    <Setter Property="Foreground" Value="#3B2A27"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề trang -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Danh sách đơn hàng"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#3B2A27"/>

            <TextBlock Text="Theo dõi và xử lý các đơn hàng của quán"
                       FontSize="13"
                       Foreground="#82736D"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Khu vực danh sách -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="20"
                BorderBrush="#DED8D3"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Các thao tác -->
                <DockPanel Grid.Row="0"
                           Margin="0,0,0,16"
                           LastChildFill="True">

                    <TextBlock Text="Quản lý đơn hàng"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#3B2A27"
                               VerticalAlignment="Center"/>

                    <WrapPanel DockPanel.Dock="Right"
                               HorizontalAlignment="Right">

                        <Button Content="Làm mới"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                        <Button Content="Bàn giao"
                                Command="{Binding CompleteCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Hủy đơn mới"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource CancelButtonStyle}"/>
                    </WrapPanel>
                </DockPanel>

                <!-- Bảng đơn hàng -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          RowHeight="44"
                          FontSize="13"
                          Foreground="#3B2A27"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#FAF8F5"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEE8E2"
                          VerticalGridLinesBrush="#F0EBE6"
                          BorderBrush="#DED8D3"
                          BorderThickness="1"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã đơn"
                                            Binding="{Binding OrderCode}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Bàn"
                                            Binding="{Binding TableName}"
                                            Width="90"/>

                        <DataGridTextColumn Header="Loại đơn"
                                            Binding="{Binding OrderType}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Trạng thái"
                                            Binding="{Binding OrderStatus}"
                                            Width="110"/>

                        <DataGridTextColumn Header="Tổng tiền"
                                            Binding="{Binding TotalAmount,
                                                      StringFormat={}{0:N0}}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Thông báo -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Message}"
                   Foreground="#A34F36"
                   Margin="2,12,0,0"
                   TextWrapping="Wrap"
                   FontSize="12"/>
    </Grid>
</Page>