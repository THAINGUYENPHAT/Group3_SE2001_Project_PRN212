<Page x:Class="CoffeeRuu.Views.WarehousePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoffeeRuu.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WarehousePage">

    <Grid Margin="25">

        <StackPanel>

            <TextBlock Text="Quản lý kho hàng"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#3B2F2F"/>

            <TextBlock Text="Quản lý nguyên liệu và tồn kho"
                       FontSize="14"
                       Foreground="#777777"
                       Margin="0,8,0,20"/>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="25">

                <TextBlock Text="Chức năng kho hàng đang được phát triển."
                           FontSize="15"
                           Foreground="#666666"/>

            </Border>

        </StackPanel>

    </Grid>
</Page>
