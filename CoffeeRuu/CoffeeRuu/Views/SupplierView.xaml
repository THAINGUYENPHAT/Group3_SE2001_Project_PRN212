
<Page x:Class="CoffeeRuu.Views.SupplierView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F0">

    <Page.Resources>

        <!-- NUT CHINH -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#4E342E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="BorderBrush" Value="#4E342E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#654A40"/>
                    <Setter Property="BorderBrush" Value="#654A40"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#35231F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- NUT PHU -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="BorderBrush" Value="#DED2CA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DCD0C8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- O NHAP LIEU -->
        <Style x:Key="InputStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="BorderBrush" Value="#D8CEC8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- COMBOBOX -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="BorderBrush" Value="#D8CEC8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- THE TIEU DE -->
        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4E342E"/>
        </Style>

        <!-- CARD -->
        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E8E0DA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- DATAGRID -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="BorderBrush" Value="#E4DCD6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEE7E2"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#FAF8F6"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- HEADER DATAGRID -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <!-- HEADER -->
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Quản lý nhà cung cấp"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#3B2A27"/>

                <TextBlock
                    Text="Quản lý thông tin và trạng thái hợp tác với nhà cung cấp."
                    FontSize="13"
                    Foreground="#82736C"
                    Margin="0,7,0,0"/>
            </StackPanel>

            <!-- DANH SACH NHA CUNG CAP -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,18">

                <StackPanel>

                    <DockPanel Margin="0,0,0,18"
                               LastChildFill="False">

                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Danh sách nhà cung cấp"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock
                                Text="Tra cứu và chọn nhà cung cấp cần quản lý"
                                FontSize="12"
                                Foreground="#82736C"
                                Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Làm mới"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                DockPanel.Dock="Right"
                                Margin="10,0,0,0"/>
                    </DockPanel>

                    <!-- TIM KIEM -->
                    <Border Background="#F8F3EF"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Tìm kiếm"
                                       FontWeight="SemiBold"
                                       Foreground="#4E342E"
                                       Grid.Column="0"/>

                            <TextBox Grid.Column="2"
                                     MaxWidth="420"
                                     HorizontalAlignment="Stretch"
                                     Style="{StaticResource InputStyle}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>

                    <!-- BANG NHA CUNG CAP -->
                    <DataGrid Height="300"
                              ItemsSource="{Binding SuppliersView}"
                              SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="44"
                              ColumnHeaderHeight="42">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="ID"
                                Binding="{Binding SupplierId}"
                                Width="60"/>

                            <DataGridTextColumn
                                Header="Tên nhà cung cấp"
                                Binding="{Binding SupplierName}"
                                Width="2*"/>

                            <DataGridTextColumn
                                Header="Số điện thoại"
                                Binding="{Binding Phone}"
                                Width="1.2*"/>

                            <DataGridTextColumn
                                Header="Email"
                                Binding="{Binding Email}"
                                Width="2*"/>

                            <DataGridTextColumn
                                Header="Địa chỉ"
                                Binding="{Binding Address}"
                                Width="2*"/>

                            <DataGridTemplateColumn
                                Header="Trạng thái"
                                Width="130">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12"
                                                Padding="9,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="#FBE9E7"/>

                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsActive}"
                                                            Value="True">
                                                            <Setter Property="Background"
                                                                    Value="#E5F3E8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="11"
                                                       FontWeight="SemiBold">

                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                                Value="Ngừng hợp tác"/>

                                                        <Setter Property="Foreground"
                                                                Value="#A52A22"/>

                                                        <Style.Triggers>
                                                            <DataTrigger
                                                                Binding="{Binding IsActive}"
                                                                Value="True">
                                                                <Setter Property="Text"
                                                                        Value="Đang hợp tác"/>

                                                                <Setter Property="Foreground"
                                                                        Value="#267344"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>

                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

            <!-- FORM THONG TIN -->
            <Border Style="{StaticResource CardStyle}">

                <StackPanel>

                    <TextBlock Text="Thông tin nhà cung cấp"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock
                        Text="Chọn một nhà cung cấp trong danh sách để chỉnh sửa thông tin."
                        FontSize="12"
                        Foreground="#82736C"
                        Margin="0,6,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TEN NHA CUNG CAP -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0">

                            <TextBlock Text="Tên nhà cung cấp"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding SupplierNameInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- SO DIEN THOAI -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2">

                            <TextBlock Text="Số điện thoại"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding PhoneInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- EMAIL -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="0">

                            <TextBlock Text="Email"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding EmailInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- DIA CHI -->
                        <StackPanel Grid.Row="2"
                                    Grid.Column="2">

                            <TextBlock Text="Địa chỉ"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding AddressInput, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- CAC NUT CHUC NANG -->
                    <Border Background="#F8F3EF"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,22,0,0">

                        <StackPanel>
                            <TextBlock Text="Thao tác"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#6D5147"
                                       Margin="0,0,0,12"/>

                            <WrapPanel>
                                <Button Content="Thêm mới"
                                        Command="{Binding AddCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>

                                <Button Content="Cập nhật"
                                        Command="{Binding UpdateCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                                <Button Content="{Binding ToggleButtonText}"
                                        Command="{Binding ToggleActiveCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"/>

                                <Button Content="Làm trống"
                                        Command="{Binding ClearCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- THONG BAO -->
                    <Border Background="#F8F3EF"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,14,0,0">

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#5D514B"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
