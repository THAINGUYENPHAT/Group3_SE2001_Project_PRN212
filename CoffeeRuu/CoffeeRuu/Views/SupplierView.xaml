<Page x:Class="CoffeeRuu.Views.SupplierView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>

        <!-- Button chính -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#433431"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Button phụ -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#EAEAEA"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="InputStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,30">

            <!-- Tiêu đề -->
            <TextBlock Text="Quản lý nhà cung cấp"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#433431"/>

            <TextBlock
                Text="Quản lý thông tin và trạng thái hợp tác với nhà cung cấp."
                FontSize="14"
                Foreground="Gray"
                Margin="0,5,0,22"/>

            <!-- Danh sách nhà cung cấp -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="18">

                <StackPanel>

                    <!-- Tìm kiếm -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">

                            <TextBlock Text="Tìm kiếm:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <TextBox Width="240"
                                     Style="{StaticResource InputStyle}"
                                     Text="{Binding SearchText,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Làm mới"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Height="280"
                              ItemsSource="{Binding SuppliersView}"
                              SelectedItem="{Binding SelectedSupplier,
                                             Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="38"
                              ColumnHeaderHeight="38">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="ID"
                                Binding="{Binding SupplierId}"
                                Width="50"/>

                            <DataGridTextColumn
                                Header="Tên nhà cung cấp"
                                Binding="{Binding SupplierName}"
                                Width="2*"/>

                            <DataGridTextColumn
                                Header="Số điện thoại"
                                Binding="{Binding Phone}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Email"
                                Binding="{Binding Email}"
                                Width="2*"/>

                            <DataGridTextColumn
                                Header="Địa chỉ"
                                Binding="{Binding Address}"
                                Width="2*"/>

                            <!-- Trạng thái -->
                            <DataGridTemplateColumn
                                Header="Trạng thái"
                                Width="110">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Text"
                                                            Value="Ngừng hợp tác"/>

                                                    <Setter Property="Foreground"
                                                            Value="#B45309"/>

                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding IsActive}"
                                                            Value="True">

                                                            <Setter Property="Text"
                                                                    Value="Đang hợp tác"/>

                                                            <Setter Property="Foreground"
                                                                    Value="#15803D"/>

                                                        </DataTrigger>
                                                    </Style.Triggers>

                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

            <!-- Form thông tin -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,18,0,0">

                <StackPanel>

                    <TextBlock Text="Thông tin nhà cung cấp"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#433431"/>

                    <TextBlock
                        Text="Chọn một nhà cung cấp trong danh sách để chỉnh sửa."
                        Foreground="Gray"
                        Margin="0,5,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tên nhà cung cấp -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,12,15">

                            <TextBlock Text="Tên nhà cung cấp"
                                       Margin="0,0,0,6"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding SupplierNameInput,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Số điện thoại -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,0,15">

                            <TextBlock Text="Số điện thoại"
                                       Margin="0,0,0,6"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding PhoneInput,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Email"
                                       Margin="0,0,0,6"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding EmailInput,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Địa chỉ -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1">

                            <TextBlock Text="Địa chỉ"
                                       Margin="0,0,0,6"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding AddressInput,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                    </Grid>

                    <!-- Các nút chức năng -->
                    <WrapPanel Margin="0,22,0,0">

                        <Button Content="Thêm mới"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Cập nhật"
                                Command="{Binding UpdateCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                        <Button Content="{Binding ToggleButtonText}"
                                Command="{Binding ToggleActiveCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                        <Button Content="Làm trống"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                    </WrapPanel>

                    <!-- Thông báo -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
