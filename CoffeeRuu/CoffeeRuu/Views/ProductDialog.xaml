<Window x:Class="CoffeeRuu.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin món uống"
        Height="570" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F5F0">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="Thông tin món uống"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#3E2723"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Tên món uống"
                       Margin="0,0,0,5"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="ProductNameBox"
                     Height="34"
                     Padding="8"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Danh mục"
                       Margin="0,0,0,5"
                       FontWeight="SemiBold"/>

            <ComboBox x:Name="CategoryComboBox"
                      Height="34"
                      Padding="6"
                      DisplayMemberPath="CategoryName"
                      SelectedValuePath="CategoryId"
                      Margin="0,0,0,12"/>

            <TextBlock Text="Giá theo size (VNĐ)"
                       FontWeight="Bold"
                       Foreground="#4E342E"
                       Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="S - Nhỏ" Margin="0,0,0,5"/>
                    <TextBox x:Name="PriceSBox"
                             Height="34"
                             Padding="8"
                             ToolTip="Giá size S"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="3,0">
                    <TextBlock Text="M - Vừa" Margin="0,0,0,5"/>
                    <TextBox x:Name="PriceMBox"
                             Height="34"
                             Padding="8"
                             ToolTip="Để trống nếu không có size M"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                    <TextBlock Text="L - Lớn" Margin="0,0,0,5"/>
                    <TextBox x:Name="PriceLBox"
                             Height="34"
                             Padding="8"
                             ToolTip="Để trống nếu không có size L"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Mô tả"
                       Margin="0,0,0,5"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="DescriptionBox"
                     Height="65"
                     Padding="8"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,12"/>

            <CheckBox x:Name="AvailableCheckBox"
                      Content="Món đang được bán"
                      IsChecked="True"
                      FontWeight="SemiBold"
                      Foreground="#4E342E"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">

            <Button Content="Hủy"
                    Width="90"
                    Height="36"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>

            <Button Content="Lưu"
                    Width="100"
                    Height="36"
                    Background="#4E342E"
                    Foreground="White"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
