<Window x:Class="CoffeeRuu.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin món uống"
        Height="440" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F5F0">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Text="Thông tin món uống"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#3E2723"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="Tên món uống"
                       Margin="0,0,0,6"
                       FontWeight="SemiBold"/>
            <TextBox x:Name="ProductNameBox"
                     Height="34"
                     Padding="8"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Danh mục"
                       Margin="0,0,0,6"
                       FontWeight="SemiBold"/>
            <ComboBox x:Name="CategoryComboBox"
                      Height="34"
                      Padding="6"
                      DisplayMemberPath="CategoryName"
                      SelectedValuePath="CategoryId"
                      Margin="0,0,0,14"/>

            <TextBlock Text="Mô tả"
                       Margin="0,0,0,6"
                       FontWeight="SemiBold"/>
            <TextBox x:Name="DescriptionBox"
                     Height="65"
                     Padding="8"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,14"/>

            <CheckBox x:Name="AvailableCheckBox"
                      Content="Món đang được bán"
                      IsChecked="True"
                      FontWeight="SemiBold"
                      Foreground="#4E342E"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button Content="Hủy"
                    Width="90"
                    Height="36"
                    Margin="0,0,10,0"
                    Background="#D7CCC8"
                    Foreground="#3E2723"
                    Click="CancelButton_Click"/>

            <Button Content="Lưu"
                    Width="100"
                    Height="36"
                    Background="#4E342E"
                    Foreground="White"
                    Click="SaveButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
