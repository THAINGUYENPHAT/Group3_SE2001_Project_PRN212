<Window x:Class="CoffeeRuu.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin món uống"
        Height="650"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9F6F0"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Màu chủ đạo -->
        <SolidColorBrush x:Key="BrownPrimary" Color="#8D6E63"/>
        <SolidColorBrush x:Key="BrownDark" Color="#4E342E"/>
        <SolidColorBrush x:Key="BrownLight" Color="#EFEBE9"/>
        <SolidColorBrush x:Key="TextBrown" Color="#3E2723"/>
        <SolidColorBrush x:Key="MutedBrown" Color="#795548"/>

        <!-- Style tiêu đề trường -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrown}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- Style TextBox -->
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrown}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7CCC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="10,0"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ComboBox -->
        <Style x:Key="InputComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrown}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7CCC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Style Button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="115"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">

            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrownDark}"/>

            <TextBlock Text="Nhập thông tin món uống bên dưới"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrown}"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- Nội dung nhập liệu -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- Tên món -->
                <TextBlock Text="Tên món uống *"
                           Style="{StaticResource FieldLabel}"/>

                <TextBox Style="{StaticResource InputTextBox}"
                         Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,17"/>

                <!-- Danh mục -->
                <TextBlock Text="Danh mục *"
                           Style="{StaticResource FieldLabel}"/>

                <ComboBox Style="{StaticResource InputComboBox}"
                          ItemsSource="{Binding Categories}"
                          DisplayMemberPath="CategoryName"
                          SelectedValuePath="CategoryId"
                          SelectedValue="{Binding SelectedCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0,0,0,17"/>

                <!-- Giá bán -->
                <TextBlock Text="Giá bán theo kích cỡ"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource BrownDark}"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,17">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Size S -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Size S *"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding PriceS, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Giá phải lớn hơn 1.000đ"/>

                    </StackPanel>

                    <!-- Size M -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Size M"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding PriceM, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Có thể để trống"/>

                    </StackPanel>

                    <!-- Size L -->
                    <StackPanel Grid.Column="4">

                        <TextBlock Text="Size L"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Style="{StaticResource InputTextBox}"
                                 Text="{Binding PriceL, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Có thể để trống"/>

                    </StackPanel>

                </Grid>

                <TextBlock Text="* Giá mỗi size phải lớn hơn 1.000đ."
                           FontSize="11"
                           Foreground="{StaticResource MutedBrown}"
                           Margin="0,-10,0,17"/>

                <!-- Mô tả -->
                <TextBlock Text="Mô tả món uống"
                           Style="{StaticResource FieldLabel}"/>

                <TextBox Height="90"
                         Padding="10"
                         FontSize="13"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="{StaticResource TextBrown}"
                         Background="White"
                         BorderBrush="#D7CCC8"
                         BorderThickness="1"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalContentAlignment="Top"
                         Margin="0,0,0,17"/>

                <!-- Trạng thái -->
                <CheckBox Content="Đang bán"
                          IsChecked="{Binding IsAvailable, Mode=TwoWay}"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="{StaticResource BrownDark}"
                          Cursor="Hand"
                          Margin="0,0,0,10"/>

                <!-- Thông báo lỗi -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

            </StackPanel>

        </ScrollViewer>

        <!-- Nút thao tác -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Hủy"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ActionButton}"
                    Background="{StaticResource BrownLight}"
                    Foreground="{StaticResource BrownDark}"
                    Margin="0,0,10,0"/>

            <Button Content="Lưu thông tin"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ActionButton}"
                    Background="{StaticResource BrownPrimary}"
                    Foreground="White"/>

        </StackPanel>

    </Grid>
</Window>
