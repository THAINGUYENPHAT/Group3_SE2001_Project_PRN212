<Page x:Class="CoffeeRuu.Views.IngredientView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F5F6FA">

    <Page.Resources>

        <!-- Button chính -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#433431"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Button phụ -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#EAEAEA"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="InputStyle"
               TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,30">

            <!-- Tiêu đề -->
            <TextBlock Text="Quản lý nguyên liệu"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#433431"/>

            <TextBlock
                Text="Quản lý danh sách và thông tin nguyên liệu trong kho."
                FontSize="14"
                Foreground="Gray"
                Margin="0,5,0,22"/>

            <!-- Danh sách nguyên liệu -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="18">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tìm kiếm và làm mới -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Tìm kiếm:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <TextBox Width="250"
                                     Style="{StaticResource InputStyle}"
                                     Text="{Binding SearchText,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Làm mới"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <!-- Bảng nguyên liệu -->
                    <DataGrid Grid.Row="1"
                              Height="285"
                              ItemsSource="{Binding IngredientsView}"
                              SelectedItem="{Binding SelectedIngredient,
                                             Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="38"
                              ColumnHeaderHeight="38">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding IngredientId}"
                                                Width="55"/>

                            <DataGridTextColumn Header="Tên nguyên liệu"
                                                Binding="{Binding IngredientName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Đơn vị"
                                                Binding="{Binding Unit}"
                                                Width="75"/>

                            <DataGridTextColumn Header="Tồn kho"
                                                Binding="{Binding CurrentStock,
                                                StringFormat=N3}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Tối thiểu"
                                                Binding="{Binding MinimumStock,
                                                StringFormat=N3}"
                                                Width="100"/>

                            <!-- Trạng thái -->
                            <DataGridTemplateColumn Header="Trạng thái"
                                                    Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"
                                                            Value="Ngừng sử dụng"/>
                                                    <Setter Property="Foreground"
                                                            Value="#B45309"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}"
                                                                     Value="True">
                                                            <Setter Property="Text"
                                                                    Value="Đang dùng"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#15803D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Form nhập liệu -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,18,0,0">

                <StackPanel>

                    <TextBlock Text="Thông tin nguyên liệu"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#433431"/>

                    <TextBlock
                        Text="Chọn một nguyên liệu trong danh sách để chỉnh sửa."
                        Foreground="Gray"
                        Margin="0,5,0,15"/>

                    <!-- Các trường nhập liệu -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tên nguyên liệu -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Tên nguyên liệu"
                                       Margin="0,0,0,6"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding IngredientNameInput,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Đơn vị -->
                        <StackPanel Grid.Column="1"
                                    Margin="0,0,12,0">

                            <TextBlock Text="Đơn vị tính"
                                       Margin="0,0,0,6"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     IsEnabled="{Binding CanEditUnit}"
                                     Text="{Binding UnitInput,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Tồn kho tối thiểu -->
                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Tồn kho tối thiểu"
                                       Margin="0,0,0,6"/>

                            <TextBox Style="{StaticResource InputStyle}"
                                     Text="{Binding MinimumStockText,
                                     UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Các nút -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,22,0,0">

                        <Button Content="Thêm mới"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Cập nhật"
                                Command="{Binding UpdateCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                        <Button Content="{Binding ToggleButtonText}"
                                Command="{Binding ToggleActiveCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                        <Button Content="Làm trống"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>

                    </StackPanel>

                    <!-- Thông báo trạng thái -->
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
