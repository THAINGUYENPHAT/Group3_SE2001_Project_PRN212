<Page x:Class="CoffeeRuu.Views.OrderView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F0"
      Title="Order Processing">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#4E342E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">

            <TextBlock
                Text="Order Processing"
                FontSize="24"
                FontWeight="Bold"
                Foreground="#3B2A27"/>

            <TextBlock
                Text="Theo dõi đơn đã tạo tại Menu/POS và bàn giao khi pha chế hoàn tất."
                Foreground="#82736D"
                FontSize="12"
                Margin="0,5,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,12">

            <StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,6">

                    <TextBlock
                        Text="Đang đăng nhập: "
                        FontWeight="SemiBold"
                        Foreground="#4E342E"/>

                    <TextBlock
                        Text="{Binding CurrentEmployeeDisplay}"
                        Foreground="#657D54"/>

                </StackPanel>

                <TextBlock
                    Text="{Binding OrderPermissionMessage}"
                    Foreground="#82736D"
                    FontSize="12"
                    Margin="0,0,0,12"/>

                <WrapPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="Danh sách Cashier (tham khảo):"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#3B2A27"
                        Margin="0,0,10,8"/>

                    <ComboBox
                        Width="250"
                        Height="36"
                        ItemsSource="{Binding Employees}"
                        SelectedItem="{Binding SelectedEmployee}"
                        DisplayMemberPath="DisplayName"
                        Margin="0,0,16,8"
                        ToolTip="Chọn tên ở đây không đổi tài khoản thao tác."/>

                    <Button
                        Content="Làm mới"
                        Style="{StaticResource ActionButton}"
                        Background="#E9DFD9"
                        Foreground="#4E342E"
                        Command="{Binding RefreshCommand}"/>

                    <Button
                        Content="Bàn giao"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding CompleteCommand}"
                        IsEnabled="{Binding CanComplete}"/>

                </WrapPanel>

            </StackPanel>

        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">

                    <TextBlock
                        Text="Danh sách đơn hàng"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#3B2A27"/>

                    <TextBlock
                        Text="Chọn một đơn Ready để bàn giao. Đơn Completed được lưu trong lịch sử."
                        Foreground="#82736D"
                        FontSize="12"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <Border Grid.Row="1"
                        Background="#FAF8F6"
                        Padding="10"
                        BorderBrush="#EEE8E2"
                        BorderThickness="1"
                        CornerRadius="7"
                        Margin="0,0,0,12">

                    <WrapPanel>

                        <StackPanel Margin="0,0,12,0">

                            <TextBlock
                                Text="Tìm mã đơn"
                                FontSize="11"
                                Foreground="#82736D"
                                Margin="0,0,0,4"/>

                            <TextBox
                                Width="210"
                                Height="34"
                                Padding="8,5"
                                Text="{Binding SearchOrder, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <StackPanel Margin="0,0,12,0">

                            <TextBlock
                                Text="Trạng thái"
                                FontSize="11"
                                Foreground="#82736D"
                                Margin="0,0,0,4"/>

                            <ComboBox
                                Width="150"
                                Height="34"
                                ItemsSource="{Binding StatusOptions}"
                                SelectedItem="{Binding StatusFilter}"/>

                        </StackPanel>

                        <StackPanel>

                            <TextBlock
                                Text="Ngày tạo đơn (trống = tất cả)"
                                FontSize="11"
                                Foreground="#82736D"
                                Margin="0,0,0,4"/>

                            <DatePicker
                                Width="185"
                                Height="34"
                                SelectedDate="{Binding FilterDate}"/>

                        </StackPanel>

                    </WrapPanel>

                </Border>

                <DataGrid
                    Grid.Row="2"
                    ItemsSource="{Binding FilteredOrders}"
                    SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    RowHeight="42"
                    ColumnHeaderHeight="40"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#EEE8E2"
                    BorderBrush="#DED8D3"
                    BorderThickness="1"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.RowStyle>

                        <Style TargetType="DataGridRow">

                            <Setter Property="Background" Value="White"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding OrderStatus}"
                                             Value="New">
                                    <Setter Property="Background"
                                            Value="#FFF8E7"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding OrderStatus}"
                                             Value="Preparing">
                                    <Setter Property="Background"
                                            Value="#EAF3FF"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding OrderStatus}"
                                             Value="Ready">
                                    <Setter Property="Background"
                                            Value="#EAF8ED"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding OrderStatus}"
                                             Value="Completed">
                                    <Setter Property="Background"
                                            Value="#E5F5E9"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding OrderStatus}"
                                             Value="Cancelled">
                                    <Setter Property="Background"
                                            Value="#FDEEEE"/>
                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="Mã đơn"
                            Binding="{Binding OrderCode}"
                            Width="2*"
                            MinWidth="150"/>

                        <DataGridTextColumn
                            Header="Bàn"
                            Binding="{Binding TableName}"
                            Width="*"
                            MinWidth="80"/>

                        <DataGridTextColumn
                            Header="Loại đơn"
                            Binding="{Binding OrderType}"
                            Width="*"
                            MinWidth="90"/>

                        <DataGridTextColumn
                            Header="Trạng thái"
                            Binding="{Binding OrderStatus}"
                            Width="*"
                            MinWidth="95"/>

                        <DataGridTextColumn
                            Header="Tổng tiền"
                            Binding="{Binding TotalAmount, StringFormat={}{0:N0}}"
                            Width="*"
                            MinWidth="110"/>

                        <DataGridTextColumn
                            Header="Thời gian"
                            Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                            Width="1.5*"
                            MinWidth="150"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <TextBlock
            Grid.Row="3"
            Text="{Binding Message}"
            Foreground="#A34F36"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="4,10,0,0"/>

    </Grid>

</Page>
