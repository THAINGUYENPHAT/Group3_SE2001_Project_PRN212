<Page x:Class="CoffeeRuu.Views.OrderView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CoffeeRuu.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Loaded="Page_Loaded"
      Title="Order Processing">
    <Grid>
        <TabControl Margin="12"
                    FontSize="14">

            <TabItem Header="Tạo đơn hàng">
                <Frame x:Name="OrderCreateFrame"
                       NavigationUIVisibility="Hidden"/>
            </TabItem>

            <TabItem Header="Danh sách đơn hàng">
                <Frame x:Name="OrderListFrame"
                       NavigationUIVisibility="Hidden"/>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
