<Page x:Class="CoffeeRuu.Views.OrderView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CoffeeRuu.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderView"
      Background="#F5F6FA"
      Loaded="Page_Loaded">

    <Page.Resources>

        <!-- Khung trắng -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <!-- Ô nhập -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>

        <!-- Nút chính -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B2F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Nút phụ -->
        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E9E6E4"/>
            <Setter Property="Foreground" Value="#3B2F2F"/>
        </Style>

        <!-- Bảng -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="ColumnHeaderHeight" Value="35"/>
            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">

            <TextBlock Text="Order Processing"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#3B2F2F"/>

            <TextBlock Text="Quản lý và xử lý đơn hàng CoffeeRuu"
                       FontSize="13"
                       Foreground="#777777"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- CÁC TAB -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0">

            <!-- TAB 1: TẠO ĐƠN -->
            <TabItem Header="  Tạo đơn hàng  ">

                <Grid Margin="0,12,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="245"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- THÔNG TIN ĐƠN HÀNG -->
                    <ScrollViewer Grid.Column="0"
                                  Margin="0,0,12,0"
                                  VerticalScrollBarVisibility="Auto">

                        <Border Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="Thông tin đơn hàng"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#3B2F2F"
                                           Margin="0,0,0,15"/>

                                <TextBlock Text="Mã nhân viên (demo)"/>

                                <TextBox
                                    Style="{StaticResource InputStyle}"
                                    Text="{Binding EmployeeIdText,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Loại đơn"/>

                                <ComboBox
                                    Style="{StaticResource ComboStyle}"
                                    ItemsSource="{Binding OrderTypes}"
                                    SelectedItem="{Binding OrderType,
                                    Mode=TwoWay}"/>

                                <TextBlock Text="Chọn bàn"/>

                                <ComboBox
                                    Style="{StaticResource ComboStyle}"
                                    ItemsSource="{Binding Tables}"
                                    DisplayMemberPath="TableName"
                                    SelectedItem="{Binding SelectedTable}"
                                    IsEnabled="{Binding IsDineIn}"/>

                                <TextBlock Text="Sản phẩm / Size"/>

                                <ComboBox
                                    Style="{StaticResource ComboStyle}"
                                    ItemsSource="{Binding Menu}"
                                    DisplayMemberPath="Display"
                                    SelectedItem="{Binding SelectedMenu}"/>

                                <TextBlock Text="Số lượng"/>

                                <TextBox
                                    Style="{StaticResource InputStyle}"
                                    Text="{Binding QuantityText,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Ghi chú món"/>

                                <TextBox
                                    Style="{StaticResource InputStyle}"
                                    MaxLength="300"
                                    Text="{Binding ItemNote,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                                <Button
                                    Content="+ Thêm món"
                                    Command="{Binding AddCommand}"
                                    Style="{StaticResource PrimaryButton}"/>

                            </StackPanel>

                        </Border>
                    </ScrollViewer>

                    <!-- GIỎ HÀNG -->
                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0"
                                       Margin="0,0,0,14">

                                <Button
                                    DockPanel.Dock="Right"
                                    Content="Xóa món"
                                    Command="{Binding RemoveCommand}"
                                    Style="{StaticResource SecondaryButton}"/>

                                <TextBlock
                                    Text="Chi tiết đơn hàng"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="#3B2F2F"
                                    VerticalAlignment="Center"/>

                            </DockPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Cart}"
                                      SelectedItem="{Binding SelectedCart}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="Tên món"
                                        Binding="{Binding ProductName}"
                                        Width="*"
                                        MinWidth="90"/>

                                    <DataGridTextColumn
                                        Header="Size"
                                        Binding="{Binding SizeName}"
                                        Width="50"/>

                                    <DataGridTextColumn
                                        Header="SL"
                                        Binding="{Binding Quantity}"
                                        Width="40"/>

                                    <DataGridTextColumn
                                        Header="Thành tiền"
                                        Binding="{Binding LineTotal,
                                        StringFormat={}{0:N0}}"
                                        Width="95"/>

                                </DataGrid.Columns>

                            </DataGrid>

                            <!-- TỔNG TIỀN -->
                            <StackPanel Grid.Row="2"
                                        Margin="0,15,0,0">

                                <TextBlock
                                    Text="Ghi chú đơn hàng"
                                    Foreground="#666666"/>

                                <TextBox
                                    Style="{StaticResource InputStyle}"
                                    MaxLength="500"
                                    Text="{Binding OrderNote,
                                    UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock
                                    Text="{Binding CartTotal,
                                    StringFormat='Tổng cộng: {0:N0} đ'}"
                                    FontSize="19"
                                    FontWeight="Bold"
                                    Foreground="#3B2F2F"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,14"/>

                                <Button
                                    Content="XÁC NHẬN TẠO ĐƠN"
                                    Command="{Binding CreateCommand}"
                                    Style="{StaticResource PrimaryButton}"/>

                            </StackPanel>

                        </Grid>
                    </Border>

                </Grid>

            </TabItem>

            <!-- TAB 2: DANH SÁCH ĐƠN HÀNG -->
            <TabItem Header="  Danh sách đơn hàng  ">

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,12,0,0">

                    <DockPanel>

                        <StackPanel DockPanel.Dock="Top"
                                    Margin="0,0,0,12">

                            <TextBlock
                                Text="Danh sách đơn hàng"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="#3B2F2F"
                                Margin="0,0,0,12"/>

                            <WrapPanel>

                                <Button
                                    Content="Làm mới"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8"/>

                                <Button
                                    Content="Bàn giao"
                                    Command="{Binding CompleteCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,8"/>

                                <Button
                                    Content="Hủy đơn mới"
                                    Command="{Binding CancelCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,8"/>

                            </WrapPanel>
                        </StackPanel>

                        <!-- BẢNG DANH SÁCH ĐƠN -->
                        <DataGrid
                            ItemsSource="{Binding Orders}"
                            SelectedItem="{Binding SelectedOrder}"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                    Header="Mã đơn"
                                    Binding="{Binding OrderCode}"
                                    Width="*"
                                    MinWidth="120"/>

                                <DataGridTextColumn
                                    Header="Bàn"
                                    Binding="{Binding TableName}"
                                    Width="80"/>

                                <DataGridTextColumn
                                    Header="Loại đơn"
                                    Binding="{Binding OrderType}"
                                    Width="85"/>

                                <DataGridTextColumn
                                    Header="Trạng thái"
                                    Binding="{Binding OrderStatus}"
                                    Width="90"/>

                                <DataGridTextColumn
                                    Header="Tổng tiền"
                                    Binding="{Binding TotalAmount,
                                    StringFormat={}{0:N0}}"
                                    Width="100"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </DockPanel>
                </Border>

            </TabItem>

        </TabControl>

        <!-- THÔNG BÁO -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Message}"
                   Foreground="#A34F36"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>

    </Grid>
</Page>
