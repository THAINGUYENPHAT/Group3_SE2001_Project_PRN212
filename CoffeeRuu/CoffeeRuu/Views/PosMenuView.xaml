<UserControl x:Class="CoffeeRuu.Views.PosMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F5F0" Height="550" Width="846">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- KHU VỰC BÊN TRÁI: Danh mục & Danh sách món uống -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề & Tìm kiếm nhanh -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="☕ Danh mục Menu" FontSize="22" FontWeight="Bold" Foreground="#3E2723"/>
                <TextBlock Text="Chọn món nhanh để thêm vào hóa đơn" FontSize="13" Foreground="#795548"/>
            </StackPanel>

            <!-- Thanh lọc danh mục -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Tất cả" Width="90" Height="32" Background="#4E342E" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="Cà phê" Width="90" Height="32" Background="#D7CCC8" Foreground="#3E2723" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="Trà sữa" Width="90" Height="32" Background="#D7CCC8" Foreground="#3E2723" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0"/>
                <Button Content="Đồ ăn vặt" Width="90" Height="32" Background="#D7CCC8" Foreground="#3E2723" FontWeight="SemiBold" BorderThickness="0"/>
            </StackPanel>

            <!-- Lưới hiển thị danh sách sản phẩm (ItemsControl dạng Card) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MenuCardItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="160" Height="180" Background="White" CornerRadius="8" Margin="0,0,12,12" Cursor="Hand" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Ảnh món (hoặc Placeholder icon) -->
                                    <Border Grid.Row="0" Background="#EFEBE9" CornerRadius="6">
                                        <TextBlock Text="☕" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Tên món -->
                                    <TextBlock Grid.Row="1" Text="{Binding ProductName}" FontWeight="Bold" FontSize="13" Foreground="#3E2723" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>

                                    <!-- Giá tiền -->
                                    <TextBlock Grid.Row="2" Text="{Binding Price, StringFormat={}{0:N0} đ}" FontWeight="SemiBold" FontSize="13" Foreground="#C62828"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- KHU VỰC BÊN PHẢI: Hóa đơn tạm tính / Giỏ hàng -->
        <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#D7CCC8" BorderThickness="1">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🛒 Hóa đơn hiện tại" FontSize="16" FontWeight="Bold" Foreground="#3E2723" Margin="0,0,0,10"/>

                <!-- Danh sách món đã chọn trong hóa đơn -->
                <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên món" Width="*"/>
                        <DataGridTextColumn Header="SL" Width="40"/>
                        <DataGridTextColumn Header="Tiền" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Thanh toán tổng tiền -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Separator Background="#E0E0E0" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Tổng cộng:" FontWeight="Bold" FontSize="14" Foreground="#3E2723"/>
                        <TextBlock Text="0 đ" FontWeight="Bold" FontSize="16" Foreground="#C62828" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Button Content="Thanh toán / In hóa đơn" Height="40" Background="#4E342E" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>