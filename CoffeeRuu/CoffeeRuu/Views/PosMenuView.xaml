
<UserControl x:Class="CoffeeRuu.Views.PosMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="0"
             MinHeight="0"
             ClipToBounds="True">

    <UserControl.Resources>
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D7C4BA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#BCA69B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SizeAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F0"/>
            <Setter Property="Foreground" Value="#4E342E"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E9DFD9"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#BCA69B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D7C4BA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAF8F5"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEE7E2"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EEE7E2"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style x:Key="PosDataGridHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="PosTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PosComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="0"/>
            <ColumnDefinition Width="340" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: DANH SÁCH MÓN -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề và tìm kiếm -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Danh mục Menu"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#3B2A27"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Chọn món nhanh để thêm vào hóa đơn"
                           FontSize="12"
                           Foreground="#82716A"
                           Margin="0,4,0,12"
                           TextWrapping="Wrap"/>

                <TextBox x:Name="SearchTextBox"
                         Style="{StaticResource PosTextBoxStyle}"
                         ToolTip="Nhập tên món cần tìm"
                         TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>

            <!-- Bộ lọc danh mục -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto"
                          Margin="0,0,0,8">
                <WrapPanel>
                    <Button Content="Tất cả"
                            Tag=""
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>

                    <Button Content="Cà phê"
                            Tag="Cà phê"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>

                    <Button Content="Trà sữa"
                            Tag="Trà sữa"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>

                    <Button Content="Trà trái cây"
                            Tag="Trà trái cây"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>

                    <Button Content="Đá xay"
                            Tag="Đá xay"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>

                    <Button Content="Đồ ăn vặt"
                            Tag="Đồ ăn vặt"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>
                </WrapPanel>
            </ScrollViewer>

            <!-- Danh sách thẻ món -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">

                <ItemsControl x:Name="MenuCardItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="195"
                                    MinHeight="180"
                                    Background="White"
                                    CornerRadius="10"
                                    Margin="0,0,12,12"
                                    BorderBrush="#DED8D3"
                                    BorderThickness="1"
                                    Padding="10">

                                <StackPanel>
                                    <Border Height="64"
                                            Background="#F1E9E4"
                                            CornerRadius="7">
                                        <TextBlock Text="☕"
                                                   FontSize="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{Binding ProductName}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#3B2A27"
                                               Margin="0,9,0,3"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding CategoryName}"
                                               FontSize="11"
                                               Foreground="#82716A"
                                               Margin="0,0,0,7"
                                               TextWrapping="Wrap"/>

                                    <!-- Chọn size để thêm món -->
                                    <ItemsControl ItemsSource="{Binding SizePrices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SizeAddButtonStyle}"
                                                        Click="AddToCartButton_Click"
                                                        ToolTip="Click để thêm món này vào hóa đơn">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding SizeName}"
                                                                   FontSize="11"
                                                                   Foreground="#5D4037"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Price, StringFormat={}{0:N0} đ}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#A33D32"
                                                                   Margin="4,0,6,0"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="＋"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="#4E342E"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- CỘT PHẢI: HÓA ĐƠN -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="12"
                BorderBrush="#DED8D3"
                BorderThickness="1"
                MinWidth="0">

            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề hóa đơn -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Hóa đơn hiện tại"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#3B2A27"/>

                    <TextBlock Text="Kiểm tra món và thông tin đơn hàng"
                               FontSize="11"
                               Foreground="#82716A"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Chọn loại đơn hàng và bàn -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Loại đơn hàng"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#4E342E"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="OrderTypeComboBox"
                              Style="{StaticResource PosComboBoxStyle}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Dùng tại quán"
                                      Tag="DineIn"/>
                        <ComboBoxItem Content="Mang đi"
                                      Tag="Takeaway"/>
                    </ComboBox>

                    <!-- Chỉ hiển thị khi dùng tại quán -->
                    <StackPanel x:Name="TablePanel"
                                Margin="0,12,0,0">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=OrderTypeComboBox}"
                                                 Value="DineIn">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Chọn bàn"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#4E342E"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="TableComboBox"
                                  Style="{StaticResource PosComboBoxStyle}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="TableId"/>
                    </StackPanel>
                </StackPanel>

                <!-- Các món trong hóa đơn -->
                <DataGrid Grid.Row="2"
                          x:Name="InvoiceDataGrid"
                          Style="{StaticResource PosDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource PosDataGridHeaderStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          FontSize="11"
                          MinColumnWidth="25"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên món"
                                            Binding="{Binding DisplayName}"
                                            Width="*"
                                            MinWidth="80"/>

                        <DataGridTextColumn Header="SL"
                                            Binding="{Binding Quantity}"
                                            Width="30"/>

                        <DataGridTextColumn Header="Tiền"
                                            Binding="{Binding TotalPrice, StringFormat={}{0:N0}}"
                                            Width="65"/>

                        <DataGridTextColumn Header="Ghi chú"
                                            Binding="{Binding Note}"
                                            Width="100"/>

                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="×"
                                            Background="Transparent"
                                            Foreground="#A33D32"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="RemoveFromCartButton_Click"
                                            ToolTip="Xóa món này"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tổng tiền và thanh toán -->
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <Separator Background="#E9DFD9"
                               Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Tổng cộng"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="#4E342E"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="TotalAmountText"
                                   Text="0 đ"
                                   FontWeight="Bold"
                                   FontSize="19"
                                   Foreground="#A33D32"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Button Content="Thanh toán / In hóa đơn"
                            Click="CheckoutButton_Click"
                            MinHeight="44"
                            Padding="8"
                            Background="#4E342E"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="13"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CheckoutBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="7"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CheckoutBorder"
                                                Property="Background"
                                                Value="#6D4C41"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CheckoutBorder"
                                                Property="Background"
                                                Value="#3B2A27"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="CheckoutBorder"
                                                Property="Opacity"
                                                Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
