<UserControl
    x:Class="CoffeeRuu.Views.PosMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F7F5F0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    MinWidth="0"
    MinHeight="0"
    d:DesignHeight="681"
    d:DesignWidth="1114">

    <UserControl.Resources>

        <!-- Nút danh mục chưa chọn -->
        <Style x:Key="CategoryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="75"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#EFEBE9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
            <Setter Property="BorderBrush" Value="#D7CCC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#D7CCC8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#BCAAA4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút danh mục đang chọn -->
        <Style x:Key="SelectedCategoryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource CategoryButtonStyle}">
            <Setter Property="Background" Value="#4E342E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4E342E"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="0"/>
            <ColumnDefinition Width="2*" MinWidth="220"/>
        </Grid.ColumnDefinitions>

        <!-- BÊN TRÁI: MENU -->
        <Grid Grid.Column="0"
              Margin="0,0,12,0"
              MinWidth="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HÀNG 0: TIÊU ĐỀ -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="☕ Danh mục Menu"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#3E2723"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Chọn món nhanh để thêm vào hóa đơn"
                           FontSize="13"
                           Foreground="#795548"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- HÀNG 1: THANH TÌM KIẾM -->
            <Border Grid.Row="1"
                    Height="42"
                    Margin="0,0,0,12"
                    Background="White"
                    BorderBrush="#D7CCC8"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="⌕"
                               FontSize="25"
                               Foreground="#795548"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             Padding="0,4"
                             ToolTip="Nhập tên món cần tìm..."
                             TextChanged="SearchTextBox_TextChanged"/>

                    <Button Grid.Column="2"
                            Content="×"
                            FontSize="20"
                            Foreground="#795548"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ClearSearch_Click"
                            ToolTip="Xóa nội dung tìm kiếm"/>
                </Grid>
            </Border>

            <!-- HÀNG 2: DANH MỤC -->
            <ScrollViewer Grid.Row="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="90"
                          Margin="0,0,0,12">

                <WrapPanel>
                    <Button x:Name="AllCategoryButton"
                            Content="Tất cả"
                            Style="{StaticResource SelectedCategoryButtonStyle}"
                            Click="FilterCategory_Click"
                            CommandParameter=""/>

                    <Button Content="Cà phê"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="FilterCategory_Click"
                            CommandParameter="Cà phê"/>

                    <Button Content="Trà sữa"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="FilterCategory_Click"
                            CommandParameter="Trà sữa"/>

                    <Button Content="Trà trái cây"
                            MinWidth="85"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="FilterCategory_Click"
                            CommandParameter="Trà trái cây"/>

                    <Button Content="Đá xay"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="FilterCategory_Click"
                            CommandParameter="Đá xay"/>

                    <Button Content="Đồ ăn vặt"
                            MinWidth="85"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="FilterCategory_Click"
                            CommandParameter="Đồ ăn vặt"/>
                </WrapPanel>
            </ScrollViewer>

            <!-- HÀNG 3: DANH SÁCH MÓN -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">

                <ItemsControl x:Name="MenuCardItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="155"
                                    MinHeight="165"
                                    Background="White"
                                    CornerRadius="10"
                                    Margin="0,0,10,10"
                                    BorderBrush="#E0D8D3"
                                    BorderThickness="1"
                                    Padding="10">

                                <StackPanel>
                                    <!-- Hình minh họa -->
                                    <Border Height="48"
                                            Background="#EFEBE9"
                                            CornerRadius="7"
                                            Margin="0,0,0,8">

                                        <TextBlock Text="☕"
                                                   FontSize="27"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Tên món -->
                                    <TextBlock Text="{Binding ProductName}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="#3E2723"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,7"
                                               MaxHeight="38"/>

                                    <Separator Background="#E0E0E0"
                                               Margin="0,0,0,5"/>

                                    <!-- Size và giá -->
                                    <ItemsControl ItemsSource="{Binding ProductSizes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding SizeName}"
                                                               FontSize="11"
                                                               Foreground="#795548"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Price, StringFormat={}{0:N0} đ}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#C62828"
                                                               VerticalAlignment="Center"
                                                               Margin="5,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- BÊN PHẢI: HÓA ĐƠN -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="10"
                BorderBrush="#D7CCC8"
                BorderThickness="1"
                MinWidth="0"
                MinHeight="0">

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề hóa đơn -->
                <TextBlock Grid.Row="0"
                           Text="🛒 Hóa đơn hiện tại"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#3E2723"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"/>

                <!-- Bảng hóa đơn -->
                <DataGrid Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="White"
                          FontSize="12"
                          RowHeaderWidth="0"
                          ColumnWidth="SizeToCells"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên món"
                                            Width="*"
                                            MinWidth="65"
                                            Binding="{Binding ProductName}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="TextTrimming" Value="None"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="4,6"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="SL"
                                            Width="40"
                                            MinWidth="40"
                                            MaxWidth="40"
                                            Binding="{Binding Quantity}"/>

                        <DataGridTextColumn Header="Tiền"
                                            Width="65"
                                            MinWidth="65"
                                            MaxWidth="65"
                                            Binding="{Binding TotalPrice, StringFormat={}{0:N0} đ}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Tổng tiền và thanh toán -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Separator Background="#E0E0E0" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Tổng cộng:"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#3E2723"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="0 đ"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="#C62828"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Button Content="Thanh toán / In hóa đơn"
                            MinHeight="40"
                            Padding="8,6"
                            Background="#4E342E"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>