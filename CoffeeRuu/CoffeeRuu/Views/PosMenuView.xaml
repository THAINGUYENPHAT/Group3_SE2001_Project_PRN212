<UserControl x:Class="CoffeeRuu.Views.PosMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F5F0"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="0"
             MinHeight="0"
             ClipToBounds="True">

    <UserControl.Resources>
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D7CCC8"/>
            <Setter Property="Foreground" Value="#3E2723"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="0"/>
            <ColumnDefinition Width="320" MinWidth="250"/>
        </Grid.ColumnDefinitions>

        <!-- DANH SÁCH MÓN -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề và tìm kiếm -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="☕ Danh mục Menu"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#3E2723"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Chọn món nhanh để thêm vào hóa đơn"
                           FontSize="12"
                           Foreground="#795548"
                           Margin="0,3,0,10"
                           TextWrapping="Wrap"/>

                <TextBox x:Name="SearchTextBox"
                         Height="36"
                         Padding="9,6"
                         FontSize="13"
                         Background="White"
                         BorderBrush="#D7CCC8"
                         BorderThickness="1"
                         ToolTip="Nhập tên món cần tìm"
                         TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>

            <!-- Danh mục -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Auto"
                          Margin="0,0,0,8">
                <WrapPanel>
                    <Button Content="Tất cả"
                            Tag=""
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>

                    <Button Content="Cà phê"
                            Tag="Cà phê"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>

                    <Button Content="Trà sữa"
                            Tag="Trà sữa"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>

                    <Button Content="Trà trái cây"
                            Tag="Trà trái cây"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>

                    <Button Content="Đá xay"
                            Tag="Đá xay"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>

                    <Button Content="Đồ ăn vặt"
                            Tag="Đồ ăn vặt"
                            Style="{StaticResource CategoryButtonStyle}"
                            Click="CategoryButton_Click"/>
                </WrapPanel>
            </ScrollViewer>

            <!-- Danh sách thẻ món -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">

                <ItemsControl x:Name="MenuCardItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="190"
                                    MinHeight="175"
                                    Background="White"
                                    CornerRadius="8"
                                    Margin="0,0,10,10"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    Padding="10">

                                <StackPanel>
                                    <Border Height="55"
                                            Background="#EFEBE9"
                                            CornerRadius="6">
                                        <TextBlock Text="☕"
                                                   FontSize="30"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{Binding ProductName}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#3E2723"
                                               Margin="0,8,0,2"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding CategoryName}"
                                               FontSize="10"
                                               Foreground="#795548"
                                               Margin="0,0,0,5"
                                               TextWrapping="Wrap"/>

                                    <ItemsControl ItemsSource="{Binding SizePrices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding SizeName}"
                                                               FontSize="11"
                                                               Foreground="#5D4037"
                                                               TextWrapping="Wrap"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Price, StringFormat={}{0:N0} đ}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#C62828"
                                                               HorizontalAlignment="Right"
                                                               Margin="4,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- HÓA ĐƠN -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="10"
                BorderBrush="#D7CCC8"
                BorderThickness="1"
                MinWidth="0">

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="🛒 Hóa đơn hiện tại"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#3E2723"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"/>

                <DataGrid Grid.Row="1"
                          x:Name="InvoiceDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          FontSize="11"
                          MinColumnWidth="25"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên món"
                                            Binding="{Binding ProductName}"
                                            Width="*"
                                            MinWidth="75"/>

                        <DataGridTextColumn Header="SL"
                                            Binding="{Binding Quantity}"
                                            Width="35"/>

                        <DataGridTextColumn Header="Tiền"
                                            Binding="{Binding TotalPrice, StringFormat={}{0:N0}}"
                                            Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Separator Background="#E0E0E0"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Tổng cộng:"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#3E2723"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="0 đ"
                                   x:Name="TotalAmountText"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="#C62828"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Button Content="Thanh toán / In hóa đơn"
                            MinHeight="40"
                            Padding="6"
                            Background="#4E342E"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="12"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
