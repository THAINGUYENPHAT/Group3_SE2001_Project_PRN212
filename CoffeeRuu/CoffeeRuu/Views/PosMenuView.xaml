<UserControl x:Class="CoffeeRuu.Views.PosMenuView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 Background="#F7F5F0"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 MinWidth="0"
                 MinHeight="0"
                 ClipToBounds="True">

    <UserControl.Resources>
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D7CCC8"/>
            <Setter Property="Foreground" Value="#3E2723"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Style nút chọn size để thêm món vào giỏ -->
        <Style x:Key="SizeAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EFEBE9"/>
            <Setter Property="BorderBrush" Value="#D7CCC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="0"/>
            <ColumnDefinition Width="340" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT 1: DANH SÁCH MÓN -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề và ô tìm kiếm -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="☕ Danh mục Menu"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#3E2723"
                               TextWrapping="Wrap"/>

                <TextBlock Text="Chọn món nhanh để thêm vào hóa đơn"
                               FontSize="12"
                               Foreground="#795548"
                               Margin="0,3,0,10"
                               TextWrapping="Wrap"/>

                <TextBox x:Name="SearchTextBox"
                             Height="36"
                             Padding="9,6"
                             FontSize="13"
                             Background="White"
                             BorderBrush="#D7CCC8"
                             BorderThickness="1"
                             ToolTip="Nhập tên món cần tìm"
                             TextChanged="SearchTextBox_TextChanged"/>
            </StackPanel>

            <!-- Bộ lọc danh mục -->
            <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto"
                              Margin="0,0,0,8">
                <WrapPanel>
                    <Button Content="Tất cả" Tag="" Style="{StaticResource CategoryButtonStyle}" Click="CategoryButton_Click"/>
                    <Button Content="Cà phê" Tag="Cà phê" Style="{StaticResource CategoryButtonStyle}" Click="CategoryButton_Click"/>
                    <Button Content="Trà sữa" Tag="Trà sữa" Style="{StaticResource CategoryButtonStyle}" Click="CategoryButton_Click"/>
                    <Button Content="Trà trái cây" Tag="Trà trái cây" Style="{StaticResource CategoryButtonStyle}" Click="CategoryButton_Click"/>
                    <Button Content="Đá xay" Tag="Đá xay" Style="{StaticResource CategoryButtonStyle}" Click="CategoryButton_Click"/>
                    <Button Content="Đồ ăn vặt" Tag="Đồ ăn vặt" Style="{StaticResource CategoryButtonStyle}" Click="CategoryButton_Click"/>
                </WrapPanel>
            </ScrollViewer>

            <!-- Danh sách các thẻ món ăn -->
            <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True">

                <ItemsControl x:Name="MenuCardItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Left"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="195"
                                        MinHeight="180"
                                        Background="White"
                                        CornerRadius="8"
                                        Margin="0,0,10,10"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        Padding="10">

                                <StackPanel>
                                    <Border Height="50"
                                                Background="#EFEBE9"
                                                CornerRadius="6">
                                        <TextBlock Text="☕"
                                                       FontSize="28"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{Binding ProductName}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#3E2723"
                                                   Margin="0,6,0,2"
                                                   TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding CategoryName}"
                                                   FontSize="10"
                                                   Foreground="#795548"
                                                   Margin="0,0,0,6"
                                                   TextWrapping="Wrap"/>

                                    <!-- Nút bấm chọn từng Size để thêm vào hóa đơn -->
                                    <ItemsControl ItemsSource="{Binding SizePrices}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SizeAddButtonStyle}"
                                                            Click="AddToCartButton_Click"
                                                            ToolTip="Click để thêm món này vào hóa đơn">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                       Text="{Binding SizeName}"
                                                                       FontSize="11"
                                                                       Foreground="#5D4037"
                                                                       VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="1"
                                                                       Text="{Binding Price, StringFormat={}{0:N0} đ}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#C62828"
                                                                       Margin="4,0,6,0"
                                                                       VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="2"
                                                                       Text="➕"
                                                                       FontSize="10"
                                                                       VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- CỘT 2: HÓA ĐƠN BÊN PHẢI -->
        <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#D7CCC8"
                    BorderThickness="1"
                    MinWidth="0">

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                               Text="🛒 Hóa đơn hiện tại"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#3E2723"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>



                <!-- CHỌN LOẠI ĐƠN HÀNG -->
                <StackPanel Margin="0,30,0,15">

                    <TextBlock Text="Loại đơn hàng"
               FontWeight="SemiBold"
               Margin="0,0,0,8"/>

                    <ComboBox x:Name="OrderTypeComboBox"
              Height="35"
              SelectedIndex="0">

                        <ComboBoxItem Content="Dùng tại quán"
                      Tag="DineIn"/>

                        <ComboBoxItem Content="Mang đi"
                      Tag="Takeaway"/>

                    </ComboBox>

                    <!-- CHỈ HIỆN KHI DÙNG TẠI QUÁN -->
                    <StackPanel x:Name="TablePanel"
                Margin="0,12,0,0">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">

                                <Setter Property="Visibility"
                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger
                        Binding="{Binding SelectedItem.Tag,
                                  ElementName=OrderTypeComboBox}"
                        Value="DineIn">

                                        <Setter Property="Visibility"
                                Value="Visible"/>

                                    </DataTrigger>
                                </Style.Triggers>

                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Chọn bàn"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="TableComboBox"
                  Height="35"
                  DisplayMemberPath="Display"
                  SelectedValuePath="TableId"/>

                    </StackPanel>

                </StackPanel>

                <DataGrid Grid.Row="1"
                              x:Name="InvoiceDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              FontSize="11"
                              MinColumnWidth="25"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên món"
                                                Binding="{Binding DisplayName}"
                                                Width="*"
                                                MinWidth="80"/>

                        <DataGridTextColumn Header="SL"
                                                Binding="{Binding Quantity}"
                                                Width="30"/>

                        <DataGridTextColumn Header="Tiền"
                                                Binding="{Binding TotalPrice, StringFormat={}{0:N0}}"
                                                Width="65"/>
                        <DataGridTextColumn
                                            Header="Ghi chú"
                                                Binding="{Binding Note}"
                                                Width="130"/>

                        <!-- Cột Nút xóa món -->
                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Click="RemoveFromCartButton_Click"
                                                ToolTip="Xóa món này"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Separator Background="#E0E0E0" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                       Text="Tổng cộng:"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#3E2723"
                                       VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                       Text="0 đ"
                                       x:Name="TotalAmountText"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#C62828"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                    </Grid>

                    <Button Content="Thanh toán / In hóa đơn"
                                Click="CheckoutButton_Click"
                                MinHeight="40"
                                Padding="6"
                                Background="#4E342E"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="12"
                                BorderThickness="0"
                                Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>