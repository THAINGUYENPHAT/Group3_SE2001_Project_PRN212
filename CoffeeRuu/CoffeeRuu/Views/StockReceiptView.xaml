<Page x:Class="CoffeeRuu.Views.StockReceiptView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="StockReceiptView"
      Background="#F5F5F0"
      Loaded="Page_Loaded">

    <Page.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D8CEC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D8CEC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEE7E2"/>
            <Setter Property="BorderBrush" Value="#E4DCD6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#FAF8F6"/>
            <Setter Property="Foreground" Value="#3B2A27"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E8E0DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4E342E"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4E342E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4E342E"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#654A40"/>
                    <Setter Property="BorderBrush" Value="#654A40"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#35231F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FBE9E7"/>
            <Setter Property="Foreground" Value="#A52A22"/>
            <Setter Property="BorderBrush" Value="#F0C9C4"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5D5D1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28">

            <!-- HEADER -->
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="Nhập hàng"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#3B2A27"/>

                <TextBlock Text="Tạo phiếu nhập và cập nhật số lượng tồn kho"
                           FontSize="13"
                           Foreground="#82736C"
                           Margin="0,7,0,0"/>
            </StackPanel>

            <!-- THÔNG TIN PHIẾU -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Thông tin phiếu nhập"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nhà cung cấp"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <ComboBox
                                ItemsSource="{Binding Suppliers}"
                                SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                DisplayMemberPath="SupplierName"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ghi chú"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <TextBox
                                Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                MaxLength="500"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DANH SÁCH NGUYÊN LIỆU -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>

                    <DockPanel Margin="0,0,0,16"
                               LastChildFill="False">

                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Danh sách nguyên liệu"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#4E342E"/>

                            <TextBlock Text="Chọn nguyên liệu, nhập số lượng và đơn giá"
                                       FontSize="12"
                                       Foreground="#82736C"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right">

                            <Button Content="+ Thêm dòng"
                                    Command="{Binding AddLineCommand}"
                                    Margin="0,0,8,0"/>

                            <Button Content="Xóa dòng"
                                    Command="{Binding RemoveLineCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="0"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid
                        ItemsSource="{Binding Lines}"
                        SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        Height="230"
                        IsReadOnly="False">

                        <DataGrid.Columns>

                            <DataGridTemplateColumn Header="Nguyên liệu"
                                                    Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            Margin="4"
                                            VerticalContentAlignment="Center"
                                            ItemsSource="{Binding AvailableIngredients}"
                                            DisplayMemberPath="IngredientName"
                                            SelectedItem="{Binding SelectedIngredient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Đơn vị"
                                Width="*"
                                IsReadOnly="True"
                                Binding="{Binding SelectedIngredient.Unit}"/>

                            <DataGridTemplateColumn Header="Số lượng nhập"
                                                    Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            Margin="4"
                                            Padding="7,4"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Đơn giá"
                                                    Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            Margin="4"
                                            Padding="7,4"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding UnitCostText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Header="Thành tiền"
                                Width="1.3*"
                                IsReadOnly="True"
                                Binding="{Binding LineTotal, StringFormat={}{0:N2}}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- TỔNG TIỀN -->
                    <Border Background="#F8F3EF"
                            BorderBrush="#E8DCD4"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="0,18,0,16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tổng tiền phiếu nhập"
                                           FontSize="13"
                                           Foreground="#82736C"/>

                                <TextBlock Text="Chi phí nhập nguyên liệu"
                                           FontSize="12"
                                           Foreground="#9A8A82"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <TextBlock
                                    Text="{Binding TotalCost, StringFormat={}{0:N2}}"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="#4E342E"/>

                                <TextBlock Text=" VNĐ"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#4E342E"
                                           Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ACTIONS -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Làm mới"
                                Command="{Binding RefreshCommand}"
                                Margin="0,0,10,0"/>

                        <Button Content="Xác nhận nhập hàng"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0"/>
                    </StackPanel>

                    <TextBlock
                        Text="{Binding StatusMessage}"
                        TextWrapping="Wrap"
                        Foreground="#5D514B"
                        Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- LỊCH SỬ NHẬP HÀNG -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0">

                <StackPanel>
                    <TextBlock Text="Phiếu nhập gần đây"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#4E342E"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="Theo dõi các lần nhập nguyên liệu trước đó"
                               FontSize="12"
                               Foreground="#82736C"
                               Margin="0,0,0,16"/>

                    <DataGrid
                        ItemsSource="{Binding RecentReceipts}"
                        IsReadOnly="True"
                        Height="210">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Header="Mã phiếu"
                                Binding="{Binding StockReceiptId}"
                                Width="*"/>

                            <DataGridTextColumn
                                Header="Nhà cung cấp"
                                Binding="{Binding Supplier.SupplierName}"
                                Width="2*"/>

                            <DataGridTextColumn
                                Header="Nhân viên nhập"
                                Binding="{Binding ReceivedByNavigation.FullName}"
                                Width="2*"/>

                            <DataGridTextColumn
                                Header="Ngày nhập"
                                Binding="{Binding ReceiptDate, StringFormat='dd/MM/yyyy HH:mm'}"
                                Width="1.6*"/>

                            <DataGridTextColumn
                                Header="Tổng tiền"
                                Binding="{Binding TotalCost, StringFormat={}{0:N2}}"
                                Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
