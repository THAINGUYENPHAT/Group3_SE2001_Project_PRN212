<Page x:Class="CoffeeRuu.Views.KdsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F5F0"
      Title="Kitchen Display System">

    <Page.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DED8D3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#4E342E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,14">

            <TextBlock
                Text="Kitchen Display System (KDS)"
                FontSize="24"
                FontWeight="Bold"
                Foreground="#3B2A27"/>

            <TextBlock
                Text="Tiếp nhận món đã đặt, xem ghi chú và cập nhật trạng thái pha chế."
                FontSize="12"
                Foreground="#82736D"
                Margin="0,5,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,12">

            <StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,6">

                    <TextBlock
                        Text="Đang đăng nhập: "
                        FontWeight="SemiBold"
                        Foreground="#4E342E"/>

                    <TextBlock
                        Text="{Binding CurrentEmployeeDisplay}"
                        Foreground="#657D54"/>

                </StackPanel>

                <TextBlock
                    Text="{Binding KdsPermissionMessage}"
                    Foreground="#82736D"
                    FontSize="12"
                    Margin="0,0,0,12"/>

                <WrapPanel VerticalAlignment="Center">

                    <TextBlock
                        Text="Danh sách Barista (tham khảo):"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#3B2A27"
                        Margin="0,0,10,8"/>

                    <ComboBox
                        Width="250"
                        Height="36"
                        ItemsSource="{Binding Employees}"
                        SelectedItem="{Binding SelectedEmployee}"
                        DisplayMemberPath="DisplayName"
                        Margin="0,0,16,8"
                        ToolTip="Chọn tên không thay đổi người thực hiện thao tác."/>

                    <Button
                        Content="Làm mới"
                        Style="{StaticResource ActionButton}"
                        Background="#E9DFD9"
                        Foreground="#4E342E"
                        Command="{Binding RefreshCommand}"/>

                    <Button
                        Content="Bắt đầu pha"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding CanStart}"/>

                    <Button
                        Content="Pha xong"
                        Style="{StaticResource ActionButton}"
                        Background="#657D54"
                        Command="{Binding ReadyCommand}"
                        IsEnabled="{Binding CanReady}"/>

                </WrapPanel>

            </StackPanel>

        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,0,0,12">

                    <TextBlock
                        Text="Danh sách món đang pha"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#3B2A27"/>

                    <TextBlock
                        Text="Món Ready tự ẩn sau khi lưu thành công. Các món được nhóm theo mã đơn."
                        Foreground="#82736D"
                        FontSize="12"
                        Margin="0,4,0,0"/>

                </StackPanel>

                <Border Grid.Row="1"
                        Background="#FAF8F6"
                        BorderBrush="#EEE8E2"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="10"
                        Margin="0,0,0,12">

                    <WrapPanel>

                        <StackPanel Margin="0,0,12,0">

                            <TextBlock
                                Text="Mã đơn hoặc tên món"
                                FontSize="11"
                                Foreground="#82736D"
                                Margin="0,0,0,4"/>

                            <TextBox
                                Width="235"
                                Height="34"
                                Padding="8,5"
                                Text="{Binding SearchKds, UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                        <StackPanel>

                            <TextBlock
                                Text="Trạng thái pha chế"
                                FontSize="11"
                                Foreground="#82736D"
                                Margin="0,0,0,4"/>

                            <ComboBox
                                Width="165"
                                Height="34"
                                ItemsSource="{Binding StatusOptions}"
                                SelectedItem="{Binding FilterStatus}"/>

                        </StackPanel>

                    </WrapPanel>

                </Border>

                <ListView
                    Grid.Row="2"
                    ItemsSource="{Binding FilteredItems}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    Background="White"
                    BorderBrush="#DED8D3"
                    BorderThickness="1"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <ListView.View>

                        <GridView>

                            <GridViewColumn
                                Header="Tên món"
                                DisplayMemberBinding="{Binding ProductName}"
                                Width="240"/>

                            <GridViewColumn
                                Header="Size"
                                DisplayMemberBinding="{Binding SizeName}"
                                Width="90"/>

                            <GridViewColumn
                                Header="Số lượng"
                                DisplayMemberBinding="{Binding Quantity}"
                                Width="90"/>

                            <GridViewColumn
                                Header="Trạng thái"
                                DisplayMemberBinding="{Binding PreparationStatus}"
                                Width="125"/>

                            <GridViewColumn
                                Header="Ghi chú"
                                DisplayMemberBinding="{Binding Note}"
                                Width="260"/>

                        </GridView>

                    </ListView.View>

                    <ListView.GroupStyle>

                        <GroupStyle>

                            <GroupStyle.ContainerStyle>

                                <Style TargetType="GroupItem">

                                    <Setter Property="Template">

                                        <Setter.Value>

                                            <ControlTemplate TargetType="GroupItem">

                                                <Expander
                                                    IsExpanded="True"
                                                    Margin="0,4,0,8">

                                                    <Expander.Header>

                                                        <StackPanel Orientation="Horizontal">

                                                            <TextBlock
                                                                Text="Đơn: "
                                                                FontWeight="SemiBold"
                                                                Foreground="#4E342E"/>

                                                            <TextBlock
                                                                Text="{Binding Name}"
                                                                FontWeight="SemiBold"
                                                                Foreground="#4E342E"/>

                                                            <TextBlock
                                                                Text="  |  Số dòng món: "
                                                                Foreground="#82736D"/>

                                                            <TextBlock
                                                                Text="{Binding ItemCount}"
                                                                Foreground="#82736D"/>

                                                        </StackPanel>

                                                    </Expander.Header>

                                                    <ItemsPresenter/>

                                                </Expander>

                                            </ControlTemplate>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </GroupStyle.ContainerStyle>

                        </GroupStyle>

                    </ListView.GroupStyle>

                </ListView>

            </Grid>

        </Border>

        <TextBlock
            Grid.Row="3"
            Text="{Binding Message}"
            Foreground="#A34F36"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="4,10,0,0"/>

    </Grid>

</Page>
