<Page x:Class="CoffeeRuu.Views.KdsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CoffeeRuu.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Loaded="Page_Loaded"
      Title="Kds - pha che">
    <Page.Resources>

        <!-- Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B2F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E9E6E4"/>
            <Setter Property="Foreground" Value="#3B2F2F"/>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="37"/>
            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">

            <TextBlock
                Text="Kitchen Display System"
                FontSize="26"
                FontWeight="Bold"
                Foreground="#3B2F2F"/>

            <TextBlock
                Text="Theo dõi và cập nhật tiến độ pha chế"
                FontSize="13"
                Foreground="#777777"
                Margin="0,5,0,0"/>

        </StackPanel>

        <!-- ACTION BAR -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,14">

            <DockPanel>

                <WrapPanel DockPanel.Dock="Right">

                    <Button
                        Content="Bắt đầu pha"
                        Command="{Binding StartCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"/>

                    <Button
                        Content="Pha xong"
                        Command="{Binding ReadyCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"/>

                    <Button
                        Content="Làm mới"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}"/>

                </WrapPanel>

                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0">

                    <TextBlock
                        Text="Mã nhân viên:"
                        Foreground="#666666"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>

                    <TextBox
                        Width="65"
                        Height="32"
                        Padding="7,4"
                        Text="{Binding EmployeeIdText,
                        UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- KDS ITEM LIST -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Text="Danh sách món cần pha chế"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="#3B2F2F"
                    Margin="0,0,0,14"/>

                <DataGrid
                    Grid.Row="1"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding SelectedItem}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <!-- STATUS COLORS -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">

                            <Setter Property="Background"
                                    Value="White"/>

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding PreparationStatus}"
                                    Value="Queued">
                                    <Setter Property="Background"
                                            Value="#FFF9E6"/>
                                </DataTrigger>

                                <DataTrigger
                                    Binding="{Binding PreparationStatus}"
                                    Value="Preparing">
                                    <Setter Property="Background"
                                            Value="#EAF3FF"/>
                                </DataTrigger>

                                <DataTrigger
                                    Binding="{Binding PreparationStatus}"
                                    Value="Ready">
                                    <Setter Property="Background"
                                            Value="#EAF8ED"/>
                                </DataTrigger>

                            </Style.Triggers>

                        </Style>
                    </DataGrid.RowStyle>

                    <!-- COLUMNS -->
                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="Mã đơn"
                            Binding="{Binding OrderCode}"
                            Width="110"/>

                        <DataGridTextColumn
                            Header="Bàn"
                            Binding="{Binding TableName}"
                            Width="85"/>

                        <DataGridTextColumn
                            Header="Tên món"
                            Binding="{Binding ProductName}"
                            Width="*"
                            MinWidth="100"/>

                        <DataGridTextColumn
                            Header="Size"
                            Binding="{Binding SizeName}"
                            Width="55"/>

                        <DataGridTextColumn
                            Header="SL"
                            Binding="{Binding Quantity}"
                            Width="40"/>

                        <DataGridTextColumn
                            Header="Ghi chú"
                            Binding="{Binding Note}"
                            Width="*"
                            MinWidth="100"/>

                        <DataGridTextColumn
                            Header="Trạng thái"
                            Binding="{Binding PreparationStatus}"
                            Width="100"/>

                        <DataGridTextColumn
                            Header="Thời gian"
                            Binding="{Binding CreatedAt,
                            StringFormat={}{0:HH:mm}}"
                            Width="75"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

        <!-- MESSAGE -->
        <TextBlock
            Grid.Row="3"
            Text="{Binding Message}"
            Foreground="#A34F36"
            FontSize="12"
            TextWrapping="Wrap"
            Margin="0,10,0,0"/>

    </Grid>
</Page>
