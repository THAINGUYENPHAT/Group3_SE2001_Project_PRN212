<UserControl x:Class="CoffeeRuu.Views.EmployeeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Quản lý tài khoản nhân viên"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#3B2F2F"/>

            <TextBlock Text="Quản lý thông tin, vai trò và trạng thái tài khoản"
                       FontSize="14"
                       Foreground="#777777"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Thong ke -->
        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,0,0,16">

            <Border Background="White"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Tổng tài khoản"
                               Foreground="#777777"
                               FontSize="13"/>
                    <TextBlock Text="{Binding TotalCount}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2878B5"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="16"
                    Margin="4,0">
                <StackPanel>
                    <TextBlock Text="Đang hoạt động"
                               Foreground="#777777"
                               FontSize="13"/>
                    <TextBlock Text="{Binding ActiveCount}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2E8B57"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="16"
                    Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Ngừng hoạt động"
                               Foreground="#777777"
                               FontSize="13"/>
                    <TextBlock Text="{Binding InactiveCount}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#B84A4A"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Danh sach -->
            <Border Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Background="White"
                    CornerRadius="10"
                    Padding="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFormVisible}" Value="True">
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="↻ Làm mới"
                                    Command="{Binding LoadCommand}"
                                    Height="34"
                                    Padding="10,0"
                                    Margin="10,0,8,0"/>
                            <Button Content="+ Thêm nhân viên"
                                    Command="{Binding OpenAddCommand}"
                                    Height="34"
                                    Padding="12,0"
                                    Background="#2E8B57"
                                    Foreground="White"
                                    BorderThickness="0"/>
                        </StackPanel>

                        <TextBlock Text="Danh sách tài khoản"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Padding="8"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Tìm theo họ tên, tên đăng nhập hoặc số điện thoại"/>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding RoleFilters}"
                                  SelectedItem="{Binding SelectedRoleFilter}"
                                  DisplayMemberPath="RoleName"
                                  Height="34"
                                  Padding="5"/>

                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Height="34"
                                  Padding="5"/>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding FilteredEmployees}"
                              SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              BorderThickness="0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã"
                                                Binding="{Binding EmployeeId}"
                                                Width="45"/>

                            <DataGridTextColumn Header="Tài khoản"
                                                Binding="{Binding Username}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Họ tên"
                                                Binding="{Binding FullName}"
                                                Width="1.3*"/>

                            <DataGridTextColumn Header="Điện thoại"
                                                Binding="{Binding Phone}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="1.4*"/>

                            <DataGridTextColumn Header="Vai trò"
                                                Binding="{Binding Role.RoleName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Ngày tạo"
                                                Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="90"/>

                            <DataGridTemplateColumn Header="Trạng thái"
                                                    Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Padding="7,3"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="#FCE8E6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="#E1F5E8"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                                Value="Ngừng hoạt động"/>
                                                        <Setter Property="Foreground"
                                                                Value="#B84A4A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}"
                                                                         Value="True">
                                                                <Setter Property="Text"
                                                                        Value="Đang hoạt động"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#237A45"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thao tác" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Chỉnh sửa"
                                                Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4"
                                                Background="#2878B5"
                                                Foreground="White"
                                                BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3"
                               Text="{Binding FilteredCount, StringFormat=Đang hiển thị {0} tài khoản}"
                               Foreground="#777777"
                               Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Form -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Visibility="{Binding FormVisibility}">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#3B2F2F"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Tên đăng nhập"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Margin="0,5,0,12"
                                 Padding="8"/>

                        <TextBlock Text="Mật khẩu"/>
                        <PasswordBox x:Name="PasswordInput"
                                     PasswordChanged="PasswordInput_PasswordChanged"
                                     IsVisibleChanged="PasswordInput_IsVisibleChanged"
                                     Height="36"
                                     Margin="0,5,0,5"
                                     Padding="8"/>

                        <TextBlock Text="Bắt buộc khi thêm; nhập mật khẩu mới khi đổi mật khẩu."
                                   Foreground="#777777"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Họ và tên"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Margin="0,5,0,12"
                                 Padding="8"/>

                        <TextBlock Text="Số điện thoại"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Margin="0,5,0,12"
                                 Padding="8"/>

                        <TextBlock Text="Email"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Margin="0,5,0,12"
                                 Padding="8"/>

                        <TextBlock Text="Vai trò"/>
                        <Grid Margin="0,5,0,12">
                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                      DisplayMemberPath="RoleName"
                                      Height="36"
                                      Padding="6">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedAdmin}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <TextBox Text="{Binding SelectedRole.RoleName}"
                                     Height="36"
                                     Padding="8"
                                     IsReadOnly="True">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedAdmin}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>


                        <CheckBox Content="Tài khoản đang hoạt động"
          IsChecked="{Binding IsActive}"
          Margin="0,0,0,18">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectedAdmin}"
                             Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <Button Content="➕ Lưu nhân viên mới"
                                Command="{Binding AddCommand}"
                                Height="40"
                                Margin="0,0,0,8"
                                Background="#2E8B57"
                                Foreground="White"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="💾 Lưu thay đổi"
                                Command="{Binding UpdateCommand}"
                                IsEnabled="{Binding CanUpdate}"
                                Height="40"
                                Margin="0,0,0,8"
                                Background="#2878B5"
                                Foreground="White"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddMode}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🔑 Đổi mật khẩu"
                                Command="{Binding ChangePasswordCommand}"
                                IsEnabled="{Binding CanUpdate}"
                                Height="40"
                                Margin="0,0,0,8"
                                Background="#7654A5"
                                Foreground="White"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🔒 Vô hiệu hóa tài khoản"
                                Command="{Binding DeactivateCommand}"
                                IsEnabled="{Binding CanDeactivate}"
                                Height="40"
                                Margin="0,0,0,8"
                                Background="#B84A4A"
                                Foreground="White"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Hủy"
                                Command="{Binding CancelCommand}"
                                Height="38"
                                Margin="0,0,0,8"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="#5D4037"
                   FontSize="13"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
