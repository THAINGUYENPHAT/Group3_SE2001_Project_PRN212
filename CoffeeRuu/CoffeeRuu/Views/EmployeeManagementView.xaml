<UserControl x:Class="CoffeeRuu.Views.EmployeeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F0">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CoffeeBrown" Color="#4E342E"/>
        <SolidColorBrush x:Key="CoffeeDark" Color="#3B2A27"/>
        <SolidColorBrush x:Key="CoffeeLight" Color="#E9DFD9"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DED8D3"/>
        <SolidColorBrush x:Key="TextColor" Color="#3B2F2F"/>
        <SolidColorBrush x:Key="MutedText" Color="#817773"/>

        <!-- Nut bam chung -->
        <Style x:Key="CoffeeButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource CoffeeBrown}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- O nhap lieu -->
        <Style x:Key="CoffeeTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush" Value="#8D6E63"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danh sach lua chon -->
        <Style x:Key="CoffeeComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Tieu de cot -->
        <Style x:Key="CoffeeColumnHeader"
               TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#E9DFD9"/>
            <Setter Property="Foreground" Value="#4E342E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#D7C9C1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Dong du lieu -->
        <Style x:Key="CoffeeDataGridRow" TargetType="{x:Type DataGridRow}">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEE9E5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F2EE"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EDE0D8"/>
                    <Setter Property="Foreground" Value="#3B2A27"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tieu de -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="☕  Quản lý nhân viên"
                       FontSize="27"
                       FontWeight="Bold"
                       Foreground="{StaticResource CoffeeDark}"/>
            <TextBlock Text="Quản lý thông tin, vai trò và trạng thái tài khoản nhân viên"
                       FontSize="13"
                       Foreground="{StaticResource MutedText}"
                       Margin="2,6,0,0"/>
        </StackPanel>

        <!-- Thong ke -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="9"
                    Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TỔNG TÀI KHOẢN"
                               Foreground="{StaticResource MutedText}"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalCount}"
                               FontSize="27" FontWeight="Bold"
                               Foreground="{StaticResource CoffeeBrown}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="9"
                    Padding="16" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="ĐANG HOẠT ĐỘNG"
                               Foreground="{StaticResource MutedText}"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveCount}"
                               FontSize="27" FontWeight="Bold"
                               Foreground="#56816A" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="9"
                    Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="NGỪNG HOẠT ĐỘNG"
                               Foreground="{StaticResource MutedText}"
                               FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding InactiveCount}"
                               FontSize="27" FontWeight="Bold"
                               Foreground="#B45B52" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Khu vuc danh sach va form -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Danh sach nhan vien -->
            <Border Grid.Column="0" Grid.ColumnSpan="3"
                    Background="White"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFormVisible}" Value="True">
                                <Setter Property="Grid.ColumnSpan" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tieu de danh sach -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="↻ Làm mới"
                                    Command="{Binding LoadCommand}"
                                    Style="{StaticResource CoffeeButton}"
                                    Background="#E9DFD9"
                                    Foreground="{StaticResource CoffeeBrown}"
                                    Margin="0,0,8,0"/>
                            <Button Content="+ Thêm nhân viên"
                                    Command="{Binding OpenAddCommand}"
                                    Style="{StaticResource CoffeeButton}"/>
                        </StackPanel>

                        <TextBlock Text="Danh sách nhân viên"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource CoffeeDark}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Tim kiem va loc -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource CoffeeTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Tìm theo họ tên, tên đăng nhập hoặc số điện thoại"/>

                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource CoffeeComboBox}"
                                  ItemsSource="{Binding RoleFilters}"
                                  SelectedItem="{Binding SelectedRoleFilter}"
                                  DisplayMemberPath="RoleName"/>

                        <ComboBox Grid.Column="4"
                                  Style="{StaticResource CoffeeComboBox}"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter}"/>
                    </Grid>

                    <!-- Bang nhan vien -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding FilteredEmployees}"
                              SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              Background="White"
                              FontSize="12"
                              ColumnHeaderStyle="{StaticResource CoffeeColumnHeader}"
                              RowStyle="{StaticResource CoffeeDataGridRow}"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã"
                                                Binding="{Binding EmployeeId}"
                                                Width="45"/>
                            <DataGridTextColumn Header="Tài khoản"
                                                Binding="{Binding Username}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Họ tên"
                                                Binding="{Binding FullName}"
                                                Width="1.3*"/>
                            <DataGridTextColumn Header="Điện thoại"
                                                Binding="{Binding Phone}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="1.4*"/>
                            <DataGridTextColumn Header="Vai trò"
                                                Binding="{Binding Role.RoleName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Ngày tạo"
                                                Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="90"/>

                            <DataGridTemplateColumn Header="Trạng thái" Width="112">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="7,4"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="#F5E5E2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#E4EEE5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Text" Value="Ngừng hoạt động"/>
                                                        <Setter Property="Foreground" Value="#A64F46"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Đang hoạt động"/>
                                                                <Setter Property="Foreground" Value="#426C4E"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Thao tác" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Chỉnh sửa"
                                                Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CoffeeButton}"
                                                Height="30" Padding="8,0" FontSize="11"
                                                Background="#E9DFD9"
                                                Foreground="{StaticResource CoffeeBrown}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3"
                               Text="{Binding FilteredCount, StringFormat=Đang hiển thị {0} tài khoản}"
                               Foreground="{StaticResource MutedText}"
                               FontSize="12" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- Form them va sua nhan vien -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="18"
                    Visibility="{Binding FormVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource CoffeeDark}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Nhập thông tin tài khoản nhân viên"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,0,0,18"/>

                        <TextBlock Text="Tên đăng nhập" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CoffeeTextBox}" Margin="0,6,0,13"/>

                        <TextBlock Text="Mật khẩu" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
                        <Grid Margin="0,6,0,5">
                            <PasswordBox x:Name="PasswordInput"
                                         PasswordChanged="PasswordInput_PasswordChanged"
                                         Height="36" Padding="10,6,36,6"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{StaticResource BorderColor}"
                                         BorderThickness="1" Background="White"/>
                            <TextBox x:Name="PasswordTextInput"
                                     TextChanged="PasswordTextInput_TextChanged"
                                     Style="{StaticResource CoffeeTextBox}"
                                     Padding="10,6,36,6"
                                     Visibility="Collapsed"/>
                            <Button x:Name="TogglePasswordButton"
                                    Content="👁" Width="30" Height="30"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,3,0" Background="Transparent"
                                    Foreground="{StaticResource CoffeeBrown}"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="TogglePasswordButton_Click"
                                    ToolTip="Hiện hoặc ẩn mật khẩu"/>
                        </Grid>
                        <TextBlock Text="Bắt buộc khi thêm; nhập mật khẩu mới khi đổi mật khẩu."
                                   Foreground="{StaticResource MutedText}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,0,0,13"/>

                        <TextBlock Text="Họ và tên" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CoffeeTextBox}" Margin="0,6,0,13"/>

                        <TextBlock Text="Số điện thoại" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CoffeeTextBox}" Margin="0,6,0,13"/>

                        <TextBlock Text="Email" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CoffeeTextBox}" Margin="0,6,0,13"/>

                        <TextBlock Text="Vai trò" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
                        <Grid Margin="0,6,0,13">
                            <ComboBox ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                      DisplayMemberPath="RoleName">
                                <ComboBox.Style>
                                    <Style TargetType="{x:Type ComboBox}"
                                           BasedOn="{StaticResource CoffeeComboBox}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedAdmin}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <TextBox Text="{Binding SelectedRole.RoleName}" IsReadOnly="True">
                                <TextBox.Style>
                                    <Style TargetType="{x:Type TextBox}"
                                           BasedOn="{StaticResource CoffeeTextBox}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedAdmin}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>

                        <CheckBox Content="Tài khoản đang hoạt động"
                                  IsChecked="{Binding IsActive}"
                                  Foreground="{StaticResource TextColor}"
                                  FontSize="12" Margin="0,0,0,18">
                            <CheckBox.Style>
                                <Style TargetType="{x:Type CheckBox}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectedAdmin}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <!-- Nut them moi: Style chi khai bao mot lan -->
                        <Button Content="➕  Lưu nhân viên mới"
                                Command="{Binding AddCommand}"
                                Height="40" Margin="0,0,0,8">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource CoffeeButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Nut cap nhat -->
                        <Button Content="💾  Lưu thay đổi"
                                Command="{Binding UpdateCommand}"
                                IsEnabled="{Binding CanUpdate}"
                                Height="40" Margin="0,0,0,8">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource CoffeeButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Background" Value="#76584B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddMode}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Nut doi mat khau -->
                        <Button Content="🔑  Đổi mật khẩu"
                                Command="{Binding ChangePasswordCommand}"
                                IsEnabled="{Binding CanUpdate}"
                                Height="40" Margin="0,0,0,8">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource CoffeeButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background" Value="#80665B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Nut vo hieu hoa -->
                        <Button Content="🔒  Vô hiệu hóa tài khoản"
                                Command="{Binding DeactivateCommand}"
                                IsEnabled="{Binding CanDeactivate}"
                                Height="40" Margin="0,0,0,8">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource CoffeeButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Background" Value="#A64F46"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Hủy"
                                Command="{Binding CancelCommand}"
                                Height="38"
                                Background="#E9DFD9"
                                Foreground="{StaticResource CoffeeBrown}"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Thong bao -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource CoffeeBrown}"
                   FontSize="12" Margin="2,12,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
