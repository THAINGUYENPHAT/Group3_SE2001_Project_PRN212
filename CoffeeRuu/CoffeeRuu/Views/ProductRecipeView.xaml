<UserControl x:Class="CoffeeRuu.Views.ProductRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F0">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Danh sách Món & Size -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" BorderBrush="#DED8D3" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="Danh sách Món" FontSize="16" FontWeight="Bold" Foreground="#3B2A27" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding ProductSizes}" SelectedItem="{Binding SelectedProductSize}" DisplayMemberPath="SizeName"/>
            </DockPanel>
        </Border>

        <!-- Khung thiết lập công thức -->
        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="#DED8D3" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Định lượng nguyên liệu" FontSize="16" FontWeight="Bold" Foreground="#3B2A27" Margin="0,0,0,15"/>

                <!-- Form thêm nguyên liệu -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Height="36" ItemsSource="{Binding AvailableIngredients}" SelectedItem="{Binding SelectedIngredientToAdd}" DisplayMemberPath="IngredientName"/>
                    <TextBox Grid.Column="2" Height="36" Text="{Binding QuantityUsedInput, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="4" Content="＋ Thêm vào công thức" Command="{Binding AddIngredientCommand}" Height="36" Padding="12,0" Background="#4E342E" Foreground="White" FontWeight="SemiBold"/>
                </Grid>

                <!-- DataGrid hiển thị danh sách nguyên liệu công thức -->
                <DataGrid MinHeight="250" MaxHeight="400" ItemsSource="{Binding CurrentRecipeItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã NL" Binding="{Binding IngredientId}" Width="60"/>
                        <DataGridTextColumn Header="Tên nguyên liệu" Binding="{Binding IngredientName}" Width="2*"/>
                        <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="80"/>
                        <DataGridTextColumn Header="Định lượng (QuantityUsed)" Binding="{Binding QuantityUsed, StringFormat=N3}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="💾 Lưu công thức món" Command="{Binding SaveRecipeCommand}" Height="40" Margin="0,15,0,0" Background="#4E342E" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>